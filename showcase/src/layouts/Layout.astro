---
import { ClientRouter } from "astro:transitions";

import "../../../src/tokens/tokens.dark.css";
import "../../../src/tokens/tokens.light.css";
import "../../../src/styles/elements.css";
import "../../../src/styles/hp-latex.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";
import fontsCssRaw from "../../../assets/fonts/fonts.css?raw";
import { SITEMAP, isLeaf, type SitemapNode } from "../sitemap.ts";
import {
  github as githubIcon,
  moon,
  search as searchIcon,
  sun,
} from "../../../src/icons/index.ts";

interface Props {
  title: string;
  /** When set, render the page chrome without the left sidebar /
   * right TOC, and drop the main padding so the page content can
   * fill the full viewport width. Used by the components index. */
  fullWidth?: boolean;
  /** When set, wrap the slotted page content in an `.hp-prose`
   * container so it picks up the design system's prose chrome —
   * vertical rhythm, list indent, table chrome, 70ch max-width.
   * Long-form pages (getting-started walkthroughs, design notes)
   * opt in via this; demo pages stay out so their hp-demo blocks
   * sit flush with the viewport. */
  prose?: boolean;
}
const { title, fullWidth = false, prose = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// Inline the @font-face rules so the browser discovers the woff2
// URLs during HTML parse instead of after a fonts.css round-trip.
// Paired with the preloads below, the real faces are usually in
// before first paint — headings stop flashing the ui-sans-serif
// fallback on cold loads. The generated fonts.css stays the source
// of truth; its CSS-relative URLs are rebased onto the site's font
// directory here.
const fontFaceCss = fontsCssRaw.replaceAll('url("./', `url("${baseUrl}/fonts/`);

// Only the faces above-the-fold text always uses: Chakra Petch 400
// (body) and 700 (headline / label), Iceland (brand + display
// headings). Mono and the remaining weights load lazily on the
// pages that use them — preloading all eleven would crowd the
// bandwidth the critical three need.
const FONT_PRELOADS = ["chakra-petch-400.woff2", "chakra-petch-700.woff2", "iceland-400.woff2"];
const fullPath = new URL(Astro.request.url).pathname.replace(/\/$/, "") || "/";
const active = baseUrl && fullPath.startsWith(baseUrl)
  ? (fullPath.slice(baseUrl.length) || "/")
  : fullPath;

function href(path: string): string {
  return path === "/" ? baseUrl || "/" : `${baseUrl}${path}`;
}

function escapeHtml(s: string): string {
  return s
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

/** True iff `node` has the active path anywhere in its leaf descendants
 *  (or is itself the active leaf). Used to auto-open the
 *  <hp-sidebar-group> containing the current page. */
function containsActive(node: SitemapNode): boolean {
  if (isLeaf(node)) {
    return node.path === active;
  }
  return node.children.some(containsActive);
}

/** Recursively emit composable sidebar markup. Leaves become
 *  <hp-sidebar-item>, branches become <hp-sidebar-group>. */
function sidebarNodeHtml(node: SitemapNode): string {
  if (isLeaf(node)) {
    const isActive = node.path === active;
    return `<hp-sidebar-item href="${escapeHtml(href(node.path))}"${
      isActive ? " active" : ""
    }>${escapeHtml(node.title)}</hp-sidebar-item>`;
  }
  const inner = node.children.map(sidebarNodeHtml).join("");
  const open = containsActive(node) ? " open" : "";
  return `<hp-sidebar-group label="${escapeHtml(node.title)}"${open}>${inner}</hp-sidebar-group>`;
}

const sidebarNavHtml = SITEMAP.map(sidebarNodeHtml).join("");

/** Flatten the sitemap to leaves with a section breadcrumb. The
 *  search palette consumes this list directly — fuzzier indexes
 *  (fuse.js, MiniSearch) can replace the inline JSON later. */
interface SearchEntry {
  title: string;
  path: string;
  section: string;
}

function flattenLeaves(nodes: SitemapNode[], trail: string[]): SearchEntry[] {
  const out: SearchEntry[] = [];
  for (const node of nodes) {
    if (isLeaf(node)) {
      out.push({ title: node.title, path: node.path, section: trail.join(" › ") });
    } else {
      out.push(...flattenLeaves(node.children, [...trail, node.title]));
    }
  }
  return out;
}

const searchIndex = flattenLeaves(SITEMAP, []).map((e) => ({
  ...e,
  href: href(e.path),
}));

// Inline theme-init script — runs before paint so there's no
// flash-of-wrong-theme. Reads localStorage; falls back to the OS
// `prefers-color-scheme` query if no preference is stored. Setting
// `data-theme` on <html> activates the matching token override
// stylesheet ([data-theme="light"] for the light surface ladder;
// no attribute → :root defaults, which are dark).
const themeInit = `(function(){try{var s=localStorage.getItem('hp-theme');var t=s||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');document.documentElement.setAttribute('data-theme',t);}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();`;

// Apply --hp-unfold-peak from sessionStorage before the unfold
// keyframes resolve their var() refs. Forward navigation through
// hp-unfold-page (or any data-hp-unfold link) stashes the computed
// peak so the destination's ::view-transition-old(hp-unfold-source)
// keyframes can hit the right scale. This inline copy covers real
// document loads (deep links, external returns); router navigations
// re-apply on astro:after-swap instead, since the swap resets
// <html>'s style attribute. Don't clear here — playReverseArrival on
// back-nav arrival also reads it; the click handler / navigate path
// re-stamps on each forward.
const unfoldPeakInit = `(function(){try{var p=sessionStorage.getItem('hp-unfold-peak');if(p)document.documentElement.style.setProperty('--hp-unfold-peak',p);}catch(e){}})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Hexpunk</title>
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    {
      FONT_PRELOADS.map((file) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={`${baseUrl}/fonts/${file}`}
          crossorigin
        />
      ))
    }
    <style is:inline set:html={fontFaceCss}></style>
    <script is:inline set:html={themeInit}></script>
    <script is:inline set:html={unfoldPeakInit}></script>
    <style is:inline>
      /* Custom-element upgrade guard. Inline in the head because it
       * must exist BEFORE first paint: the stylesheet imported via
       * the module graph arrives with the same waterfall as the
       * element definitions, which is exactly too late. Until an
       * element upgrades it has no shadow DOM and no styles, so its
       * light-DOM children paint as plain flowing content — the
       * per-navigation flash of squashed sidebars and clumped
       * hexes. (`:defined` matches every built-in, so this touches
       * only un-upgraded customs.) */
      :not(:defined) {
        visibility: hidden;
      }

      /* The canvas grid's definition arrives via its own subpath
       * import, later than the barrel — reserve its footprint so
       * content below doesn't jump when it upgrades. Mirrors the
       * element's host sizing. */
      hp-grid:not(:defined) {
        display: block;
        width: 100%;
        min-height: 400px;
      }
    </style>
    <ClientRouter />
  </head>
  <body class={fullWidth ? "page-full-width" : ""}>
    <div class="page">
      <header>
        <a class="brand" href={href("/")}>
          <svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
            <path d="M 64 4.36 L 94 21.68 L 94 56.32 L 64 73.64 L 34 56.32 L 34 21.68 Z" />
            <path d="M 34 56.32 L 64 73.64 L 64 108.28 L 34 125.6 L 4 108.28 L 4 73.64 Z" />
            <path d="M 94 56.32 L 124 73.64 L 124 108.28 L 94 125.6 L 64 108.28 L 64 73.64 Z" />
          </svg>
          <span class="brand-text">Hexpunk</span>
        </a>
        <nav class="header-nav" aria-label="Primary">
          <a class="header-nav-link" href={href("/getting-started/install")}>Docs</a>
          <a class="header-nav-link" href={href("/components")}>Components</a>
        </nav>
        <div class="header-tools">
          <button
            type="button"
            class="header-btn search-trigger"
            id="search-trigger"
            aria-label="Search (Ctrl+K)"
            title="Search (Ctrl+K)"
          >
            <svg
              class="icon"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
              aria-hidden="true"
              set:html={searchIcon}
            ></svg>
            <span class="kbd-hint" aria-hidden="true">⌘K</span>
          </button>
          <button
            type="button"
            class="header-btn theme-toggle"
            id="theme-toggle"
            aria-label="Toggle theme"
            title="Toggle theme"
          >
            <svg
              class="icon icon-sun"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
              aria-hidden="true"
              set:html={sun}
            ></svg>
            <svg
              class="icon icon-moon"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
              aria-hidden="true"
              set:html={moon}
            ></svg>
          </button>
          <a
            class="header-btn header-github"
            href="https://github.com/zeraphie/hexpunk"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View on GitHub"
            title="View on GitHub"
          >
            <svg
              class="icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              set:html={githubIcon}
            ></svg>
          </a>
        </div>
      </header>
      <hp-sidebar
        class="page-sidebar"
        aria-label="Site map"
        set:html={sidebarNavHtml}
      ></hp-sidebar>
      <main>
        {/* Persisted across router swaps: the canvas node (and the
          frame it last drew) survives navigation, so the backdrop
          never blanks. The element's own move handling re-inits GL
          on reconnect — synchronously inside the swap, before the
          next paint. */}
        <hp-background page transition:persist="hp-background"></hp-background>
        {prose ? <div class="hp-prose"><slot /></div> : <slot />}
      </main>
      <hp-sidebar
        class="page-toc"
        variant="secondary"
        hidden
        aria-label="Contents"
      >
        <h3 class="toc-title">Contents</h3>
        <div id="page-toc-list"></div>
      </hp-sidebar>
    </div>

    <dialog class="search-palette" id="search-palette" aria-label="Search">
      <div class="search-palette-inner">
        <div class="search-input-row">
          <svg
            class="icon"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
            aria-hidden="true"
            set:html={searchIcon}
          ></svg>
          <input
            type="text"
            id="search-input"
            placeholder="Search components, pages…"
            aria-label="Search query"
            autocomplete="off"
            spellcheck="false"
          />
          <kbd class="kbd-hint">esc</kbd>
        </div>
        <ul class="search-results" id="search-results" role="listbox"></ul>
        <div class="search-empty" id="search-empty" hidden>No matches.</div>
        <div class="search-footer">
          <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </div>
    </dialog>

    <script id="search-index-data" type="application/json" set:html={JSON.stringify(searchIndex)}></script>

    <script>
      // Register every <hp-*> element on every page. Astro bundles
      // this so each page ships only what it actually needs.
      //
      // With <ClientRouter /> in the head, this document — and with
      // it this module, the registrations below, and every
      // custom-element definition — survives navigation. That is
      // what removes the per-navigation upgrade flash. The trade:
      // this module runs ONCE per session while the body is torn
      // down and rebuilt per navigation, so page wiring below is
      // either delegated (document/window listeners that resolve
      // elements at event time) or re-run per arrival via the
      // astro:page-load / astro:after-swap events at the bottom.
      import { prefetch } from "astro:prefetch";
      import { navigate, type TransitionBeforeSwapEvent } from "astro:transitions/client";

      import {
        beginUnfoldNavigation,
        buildUnfoldOverlay,
        computePeakScale,
        HpCode,
        HpLatex,
        setNavigate,
        unfoldSourceColor,
        UNFOLD_STORAGE_PEAK,
        UNFOLD_STORAGE_TARGET,
      } from "../../../src/index.ts";
      import katex from "katex";

      // ── Math renderer (KaTeX) ─────────────────────────────────
      // hp-latex ships no math engine — the showcase wires KaTeX
      // here so any <hp-latex> on a doc page renders. KaTeX's
      // renderToString is synchronous and pure (no DOM access);
      // we wrap it in a try/catch that returns null on failure so
      // hp-latex falls back to its mono-spaced source rendering
      // instead of throwing. throwOnError: false makes KaTeX
      // emit a red-highlighted error span inline rather than
      // throwing, which keeps the rest of the page rendering when
      // one expression has bad syntax.
      HpLatex.setRenderer((source, mode) => {
        try {
          return katex.renderToString(source, {
            displayMode: mode === "block",
            throwOnError: false,
          });
        } catch {
          return null;
        }
      });

      // ── Syntax highlighter (Shiki) ────────────────────────────
      // hp-code itself ships no tokeniser — the showcase registers
      // Shiki here so doc-page code blocks get themed output. Shiki
      // emits inline-styled spans (not class names) so the bundled
      // theme drives colours directly; hp-code's `.hljs-*` defaults
      // are inert with Shiki and stay for consumers who pick
      // highlight.js instead.
      //
      // Themes + langs are listed explicitly so Vite bundles them
      // for prod. Shiki's "shorthand" `codeToHtml` lazy-loads via
      // dynamic imports that Vite can't statically resolve, which
      // worked in dev but silently dropped non-default themes from
      // the prod build. `getSingletonHighlighter` accepts the
      // explicit lists upfront and the bundler picks them all up.
      //
      // The adapter reads `data-theme` on every call so re-tokenising
      // on theme toggle picks up the matching Shiki theme — no
      // re-load, both themes are already in the singleton.
      function shikiThemeFor(el?: HTMLElement): string {
        // Prefer the effective theme at the element's position (so
        // hp-code inside an hp-demo with a local theme override
        // picks the matching Shiki variant). Falls back to the site
        // theme when no element is passed.
        let name: string | undefined;
        if (el) {
          name = getComputedStyle(el)
            .getPropertyValue("--hp-theme-name")
            .trim();
        }
        if (!name) {
          name = document.documentElement.dataset.theme;
        }
        return name === "light" ? "github-light" : "tokyo-night";
      }
      // Once the singleton is warm the adapter answers SYNCHRONOUSLY:
      // hp-code applies a sync result before its first render, so on
      // every navigation after the first tokenisation of the session,
      // code paints highlighted on the first frame instead of
      // flashing plain monospace for a beat. Only the very first
      // code block of a session takes the async path.
      const SHIKI_THEMES = ["github-light", "tokyo-night"];
      const SHIKI_LANGS = ["html", "css", "javascript", "typescript", "jsx", "tsx", "bash", "json"];
      let shikiSingleton: {
        codeToHtml(code: string, options: { lang: string; theme: string }): string;
      } | null = null;

      function tokenizeWarm(code: string, lang: string, theme: string): string | null {
        try {
          const html = shikiSingleton!.codeToHtml(code, { lang, theme });
          return html.replace(/^<pre[^>]*><code[^>]*>/, "").replace(/<\/code><\/pre>$/, "");
        } catch (err) {
          // Unknown language, theme, or engine failure — surface the
          // error so it's diagnosable, then fall back to plain
          // monospaced text in hp-code.
          console.warn(`[hp-code] Shiki failed for lang="${lang}" theme="${theme}":`, err);
          return null;
        }
      }

      const shikiHighlighter: Parameters<typeof HpCode.setHighlighter>[0] = (code, lang, el) => {
        if (!lang) {
          return null;
        }
        const theme = shikiThemeFor(el);
        if (shikiSingleton) {
          return tokenizeWarm(code, lang, theme);
        }
        return (async () => {
          try {
            const { getSingletonHighlighter } = await import("shiki");
            shikiSingleton = await getSingletonHighlighter({
              themes: SHIKI_THEMES,
              langs: SHIKI_LANGS,
            });
          } catch (err) {
            console.warn(`[hp-code] Shiki failed to load:`, err);
            return null;
          }
          return tokenizeWarm(code, lang, theme);
        })();
      };
      HpCode.setHighlighter(shikiHighlighter);

      // ── Theme toggle ──────────────────────────────────────────
      // Delegated: the header button is rebuilt on every router
      // navigation, so a listener bound to one button dies with it.
      document.addEventListener("click", (ev) => {
        if (!(ev.target as Element | null)?.closest("#theme-toggle")) {
          return;
        }
        const root = document.documentElement;
        const current = root.getAttribute("data-theme") === "light" ? "light" : "dark";
        const next = current === "light" ? "dark" : "light";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("hp-theme", next);
        } catch {
          // localStorage unavailable (private mode, blocked) — theme
          // still applies for this session, just won't persist.
        }
        // Re-register the highlighter so every connected hp-code
        // re-tokenises against the new theme's Shiki variant.
        HpCode.setHighlighter(shikiHighlighter);
      });

      // ── Search palette ────────────────────────────────────────
      // Delegated at document level: the dialog and its inner
      // elements are rebuilt on every router navigation, so
      // handlers resolve the current elements by id at event time
      // instead of capturing them once.
      interface SearchEntry {
        title: string;
        path: string;
        section: string;
        href: string;
      }

      // The index is sitemap-derived and identical on every page —
      // parsing the first document's copy once is enough.
      const indexEl = document.getElementById("search-index-data");
      const SEARCH_INDEX: SearchEntry[] = indexEl ? JSON.parse(indexEl.textContent ?? "[]") : [];

      const paletteEl = () =>
        document.getElementById("search-palette") as HTMLDialogElement | null;
      const searchInputEl = () =>
        document.getElementById("search-input") as HTMLInputElement | null;

      let selected = 0;
      let current: SearchEntry[] = [];

      /** Substring + token-prefix scoring. Lower-is-better, with the
       *  earliest-match position as the tiebreaker. Tokens are
       *  whitespace-separated; an entry matches if every token is
       *  found as a substring in `title` or `section`. */
      function rank(entry: SearchEntry, tokens: string[]): number | null {
        if (!tokens.length) {
          return 0;
        }
        const haystack = (entry.title + " " + entry.section).toLowerCase();
        let total = 0;
        for (const tok of tokens) {
          const idx = haystack.indexOf(tok);
          if (idx < 0) {
            return null;
          }
          total += idx;
        }
        return total;
      }

      function render(query: string): void {
        const resultsEl = document.getElementById("search-results");
        const emptyEl = document.getElementById("search-empty");
        const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
        const matches: { entry: SearchEntry; score: number }[] = [];
        for (const entry of SEARCH_INDEX) {
          const score = rank(entry, tokens);
          if (score !== null) {
            matches.push({ entry, score });
          }
        }
        matches.sort((a, b) => a.score - b.score);
        current = matches.map((m) => m.entry);
        selected = 0;
        if (!current.length) {
          if (resultsEl) {
            resultsEl.innerHTML = "";
          }
          emptyEl?.removeAttribute("hidden");
          return;
        }
        emptyEl?.setAttribute("hidden", "");
        if (!resultsEl) {
          return;
        }
        resultsEl.innerHTML = current
          .map(
            (e, i) => `
              <li role="option" data-index="${i}" data-href="${e.href}" class="${
                i === selected ? "selected" : ""
              }">
                <span class="result-title">${e.title}</span>
                ${e.section ? `<span class="result-section">${e.section}</span>` : ""}
              </li>`,
          )
          .join("");
      }

      function highlight(): void {
        const resultsEl = document.getElementById("search-results");
        if (!resultsEl) {
          return;
        }
        const items = resultsEl.querySelectorAll<HTMLLIElement>("li");
        items.forEach((li, i) => {
          li.classList.toggle("selected", i === selected);
          if (i === selected) {
            li.scrollIntoView({ block: "nearest" });
          }
        });
      }

      function open(): void {
        const palette = paletteEl();
        if (!palette) {
          return;
        }
        palette.showModal();
        const input = searchInputEl();
        if (input) {
          input.value = "";
          input.focus();
        }
        render("");
      }

      function close(): void {
        paletteEl()?.close();
      }

      function activate(entry: SearchEntry): void {
        close();
        void navigate(entry.href);
      }

      document.addEventListener("click", (ev) => {
        const target = ev.target as Element | null;
        if (!target) {
          return;
        }
        if (target.closest("#search-trigger")) {
          open();
          return;
        }
        const li = target.closest<HTMLLIElement>("#search-results li[data-href]");
        if (li) {
          const entry = current[Number(li.dataset.index)];
          if (entry) {
            activate(entry);
          }
          return;
        }
        // Clicking outside the inner panel closes — backdrop clicks
        // land on the dialog element itself, and native <dialog>
        // doesn't close on that by default.
        if ((target as HTMLElement).id === "search-palette") {
          close();
        }
      });

      document.addEventListener("input", (ev) => {
        const input = ev.target as HTMLInputElement | null;
        if (input?.id === "search-input") {
          render(input.value);
        }
      });

      document.addEventListener("keydown", (ev) => {
        if ((ev.target as HTMLElement | null)?.id !== "search-input") {
          return;
        }
        if (ev.key === "ArrowDown") {
          ev.preventDefault();
          if (current.length) {
            selected = (selected + 1) % current.length;
            highlight();
          }
        } else if (ev.key === "ArrowUp") {
          ev.preventDefault();
          if (current.length) {
            selected = (selected - 1 + current.length) % current.length;
            highlight();
          }
        } else if (ev.key === "Enter") {
          ev.preventDefault();
          const pick = current[selected];
          if (pick) {
            activate(pick);
          }
        }
      });

      // Cmd/Ctrl-K opens the palette anywhere on the page.
      window.addEventListener("keydown", (ev) => {
        if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "k") {
          ev.preventDefault();
          if (paletteEl()?.open) {
            close();
          } else {
            open();
          }
        }
      });

      // ── Right-rail TOC + scrollspy ────────────────────────────
      // Scans visible h2/h3 headings inside <main>, builds a list of
      // <hp-sidebar-item> entries inside the page TOC, and highlights
      // the section currently in view via an IntersectionObserver.
      // Headings inside `[data-tab-panel][hidden]` are skipped — only
      // the active tab's structure contributes. Rebuilt on tab switch
      // (listening for the `hp-tabs-change` custom event) so the list
      // always matches what's shown.
      //
      // Tabs route via `?tab=…` (route="query") now, leaving the hash
      // free for heading anchors — clicking a TOC item updates
      // location.hash without disturbing the active tab.
      //
      // Element lookups live inside rebuildTOC so every run binds to
      // the page the router has just put on screen; the initial build
      // per arrival rides astro:page-load (bottom of this module).
      let tocObserver: IntersectionObserver | null = null;
      const tocItemById = new Map<string, HTMLElement>();

      function clearTocActive(): void {
        tocItemById.forEach((el) => el.removeAttribute("active"));
      }

      function escapeAttr(s: string): string {
        return s
          .replaceAll("&", "&amp;")
          .replaceAll('"', "&quot;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;");
      }

      function rebuildTOC(): void {
        const tocAside = document.querySelector<HTMLElement>(".page-toc");
        const tocList = document.getElementById("page-toc-list");
        const pageEl = document.querySelector<HTMLElement>(".page");
        const mainEl = document.querySelector<HTMLElement>("main");
        if (!tocAside || !tocList || !mainEl) {
          return;
        }
        tocObserver?.disconnect();
        tocItemById.clear();

        const all = mainEl.querySelectorAll<HTMLHeadingElement>("h2, h3");
        const visible: HTMLHeadingElement[] = [];
        all.forEach((h) => {
          // Walk ancestors: skip if any ancestor is hidden, lives
          // inside an `<hp-demo>` block (those headings are sample
          // content, not page structure), or carries `data-no-toc`
          // for one-off opt-outs.
          let el: HTMLElement | null = h;
          let skip = false;
          while (el && el !== mainEl) {
            if (
              el.hasAttribute("hidden") ||
              el.tagName.toLowerCase() === "hp-demo" ||
              el.hasAttribute("data-no-toc")
            ) {
              skip = true;
              break;
            }
            el = el.parentElement;
          }
          if (!skip) {
            visible.push(h);
          }
        });

        if (visible.length < 2) {
          // A single h2 isn't worth a TOC — skip.
          tocList.innerHTML = "";
          tocAside.setAttribute("hidden", "");
          pageEl?.classList.remove("has-toc");
          return;
        }

        const items: string[] = [];
        visible.forEach((h, i) => {
          if (!h.id) {
            // Slugify from text content; fall back to a stable index
            // so the IntersectionObserver target is consistent.
            const slug = h.textContent
              ?.toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-|-$/g, "");
            h.id = slug || `section-${i}`;
          }
          const tag = h.tagName.toLowerCase();
          items.push(
            `<hp-sidebar-item class="toc-${tag}" href="#${h.id}">${escapeAttr(h.textContent ?? "")}</hp-sidebar-item>`,
          );
        });
        tocList.innerHTML = items.join("");

        tocList
          .querySelectorAll<HTMLElement>("hp-sidebar-item")
          .forEach((el) => {
            const id = el.getAttribute("href")?.slice(1);
            if (id) {
              tocItemById.set(id, el);
            }
          });

        tocAside.removeAttribute("hidden");
        pageEl?.classList.add("has-toc");

        // Observer with a narrow band near the top of the viewport —
        // a heading is "active" once its top passes that band. The
        // band is offset by the fixed navbar height so the trigger
        // sits visibly below the navbar.
        tocObserver = new IntersectionObserver(
          (entries) => {
            // Pick the entry whose bounding rect is highest while
            // still below the trigger line. If multiple are
            // intersecting, the last one (deepest into the page) wins.
            let activeId: string | null = null;
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                activeId = entry.target.id;
              }
            });
            if (activeId) {
              clearTocActive();
              tocItemById.get(activeId)?.setAttribute("active", "");
            }
          },
          (() => {
            // rootMargin can't reference CSS custom properties, so
            // resolve --hp-navbar-height from computed style and bake
            // a literal pixel offset (+16px breathing room).
            const navH =
              parseInt(
                getComputedStyle(document.documentElement).getPropertyValue(
                  "--hp-navbar-height",
                ),
                10,
              ) || 64;
            return {
              rootMargin: `-${navH + 16}px 0px -70% 0px`,
              threshold: 0,
            };
          })(),
        );
        visible.forEach((h) => tocObserver?.observe(h));
      }

      // Tab switch hides / reveals sections — the TOC has to follow.
      // hp-tabs dispatches `hp-tabs-change` after every value update
      // regardless of route mode; listen for that. Also listen for
      // hashchange so back/forward heading-anchor navigation refreshes
      // the active highlight if needed. The initial build per arrival
      // rides astro:page-load, which fires after page scripts — by
      // then hp-tabs' connectedCallback microtask has already hidden
      // non-active panels, so the TOC never sees every heading across
      // every tab panel.
      window.addEventListener("hp-tabs-change", rebuildTOC);
      window.addEventListener("hashchange", rebuildTOC);

      // ── hp-unfold-page for text links ──────────────────────────
      // Any <a data-hp-unfold> link rides the library's shared
      // unfold departure — same overlay, keyframes, and storage
      // handshake as <hp-unfold-page> and <hp-nav-item unfold>. The
      // registered setNavigate (below) makes the expand run as a
      // same-document view transition, so the destination arrives
      // with every element already defined.
      document.addEventListener("click", (ev) => {
        const target = ev.target as Element | null;
        const link = target?.closest<HTMLAnchorElement>("a[data-hp-unfold]");
        if (!link?.href || link.target === "_blank") {
          return;
        }
        try {
          if (new URL(link.href).origin !== window.location.origin) {
            return;
          }
        } catch {
          return;
        }
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) {
          return;
        }
        ev.preventDefault();
        beginUnfoldNavigation(link, link.href);
      });

      // ── Back-nav reverse animation ────────────────────────────
      // On page load, if we're returning from a hp-unfold-page /
      // data-hp-unfold forward navigation, replay the reverse: a
      // viewport-sized overlay shrinks back to where the source
      // sits on this page. Detected via the Performance Navigation
      // Timing API (type === "back_forward") + a sessionStorage
      // marker stamped at the forward click.
      function findReturningSource(): {
        sourceEl: HTMLElement;
        color: string;
      } | null {
        const target = sessionStorage.getItem(UNFOLD_STORAGE_TARGET);
        if (!target) {
          return null;
        }
        // Only consume storage on a confirmed history-traversal
        // arrival — if this is the FORWARD nav landing, we want the
        // target to persist so the eventual back nav can read it.
        // Three signals, one per arrival path: the router's own
        // direction for same-document navigations; the Performance
        // entry type for real document loads; pageshow's persisted
        // flag for bfcache restores. The router direction wins when
        // set — on a persistent document the Performance entry
        // still describes the original load, not this navigation.
        const entries = performance.getEntriesByType(
          "navigation",
        ) as PerformanceNavigationTiming[];
        const navType = entries[0]?.type;
        const isHistoryTraversal =
          routerNavDirection !== null
            ? routerNavDirection === "back"
            : navType === "back_forward" || performanceNavPersistedHint();
        if (!isHistoryTraversal) {
          return null;
        }

        // 1) Look for an hp-unfold-page whose href resolves to the
        //    stored target — that's the exact source we navigated
        //    from.
        const unfolds = document.querySelectorAll<HTMLElement>(
          "hp-unfold-page[href]",
        );
        for (const el of unfolds) {
          try {
            const href = el.getAttribute("href");
            if (!href) {
              continue;
            }
            if (new URL(href, location.origin).pathname !== target) {
              continue;
            }
            const source = el.querySelector<HTMLElement>('[slot="source"]');
            if (!source) {
              continue;
            }
            sessionStorage.removeItem(UNFOLD_STORAGE_TARGET);
            return { sourceEl: source, color: unfoldSourceColor(source) };
          } catch {
            // Skip and continue searching.
          }
        }

        // 2) An <hp-nav-item unfold> whose href matches — the item
        //    itself is the source hexes shrink back onto.
        const navItems = document.querySelectorAll<HTMLElement>("hp-nav-item[unfold][href]");
        for (const item of navItems) {
          try {
            const itemHref = item.getAttribute("href");
            if (!itemHref || new URL(itemHref, location.origin).pathname !== target) {
              continue;
            }
            sessionStorage.removeItem(UNFOLD_STORAGE_TARGET);
            return { sourceEl: item, color: unfoldSourceColor(item) };
          } catch {
            // Skip and continue searching.
          }
        }

        // 3) Fall back to a data-hp-unfold link whose href matches.
        const links =
          document.querySelectorAll<HTMLAnchorElement>("a[data-hp-unfold]");
        for (const link of links) {
          try {
            if (new URL(link.href, location.origin).pathname !== target) {
              continue;
            }
            sessionStorage.removeItem(UNFOLD_STORAGE_TARGET);
            return { sourceEl: link, color: unfoldSourceColor(link) };
          } catch {
            // Skip and continue searching.
          }
        }
        return null;
      }

      // Used inside findReturningSource — pageshow's persisted flag
      // gets passed down via a module-scoped slot so the function
      // can stay synchronous without re-querying the event.
      let lastPageshowPersisted = false;
      function performanceNavPersistedHint(): boolean {
        return lastPageshowPersisted;
      }

      // Direction of the most recent router navigation, captured at
      // astro:before-swap and cleared once the arrival has been
      // handled (astro:page-load) or superseded by a real document
      // transition (pageshow).
      let routerNavDirection: "forward" | "back" | null = null;

      function playReverseArrival(): void {
        const match = findReturningSource();
        if (!match) {
          return;
        }
        const rect = match.sourceEl.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) {
          return;
        }
        const peak = computePeakScale(rect);
        const overlay = buildUnfoldOverlay(match.sourceEl, match.color);
        if (!overlay) {
          return;
        }
        overlay.style.transform = `scale(${peak})`;
        document.body.appendChild(overlay);
        // Force the initial scale to commit before animating, so the
        // overlay is visible covering the viewport before the shrink
        // animation begins (avoids a single-frame flash of the
        // destination page).
        void overlay.getBoundingClientRect();
        overlay
          .animate(
            [{ transform: `scale(${peak})` }, { transform: "scale(1)" }],
            {
              duration: 280,
              easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
              fill: "forwards",
            },
          )
          .finished.then(() =>
            overlay
              .animate([{ opacity: 1 }, { opacity: 0 }], {
                duration: 120,
                fill: "forwards",
              })
              .finished.then(() => overlay.remove()),
          );
      }

      // Listen for every pageshow (no { once: true }) so bfcache
      // restores fire it too — bfcache leaves the existing
      // listeners attached and re-fires pageshow on restore, but
      // a { once: true } listener was already consumed by the
      // initial load. Capture the persisted flag so findReturningSource
      // can treat a bfcache restore as equivalent to a back/forward
      // nav (`performance.getEntriesByType("navigation")[0].type`
      // doesn't always re-report "back_forward" on restore).
      window.addEventListener("pageshow", (ev) => {
        lastPageshowPersisted = (ev as PageTransitionEvent).persisted === true;
        // A pageshow means the latest transition was document-level
        // (fresh load or bfcache restore) — a router direction left
        // over from before the document went away must not decide
        // this arrival.
        routerNavDirection = null;
        if (document.body) {
          playReverseArrival();
        } else {
          window.addEventListener("DOMContentLoaded", playReverseArrival, {
            once: true,
          });
        }
      });

      // ── Client-router lifecycle ───────────────────────────────
      // Navigating hexpunk elements default to full document
      // navigations; under the router that reload is exactly the
      // flash this site avoids. One registration covers every
      // element and sequence — hp-unfold-page, hp-nav-item, and the
      // data-hp-unfold link handler above all route through it.
      setNavigate((href) => void navigate(href));

      document.addEventListener("astro:before-swap", (ev) => {
        const swap = ev as TransitionBeforeSwapEvent;
        routerNavDirection = swap.direction;
        // Stamp the active theme onto the INCOMING document before
        // the swap installs its <html> attributes. Elements connect
        // — and hp-code tokenises — during the swap itself, so
        // re-applying the theme afterwards would let a light-mode
        // page tokenise against the dark default. The incoming
        // document never carries data-theme; it's client-set.
        swap.newDocument.documentElement.setAttribute(
          "data-theme",
          document.documentElement.getAttribute("data-theme") ?? "dark",
        );
      });

      // The swap resets <html>'s style attribute to the incoming
      // page's server-rendered (empty) one, which drops the
      // --hp-unfold-peak custom property. Re-apply it after the
      // swap, before the new state paints — the same-document
      // mirror of the inline head init script.
      document.addEventListener("astro:after-swap", () => {
        try {
          const peak = sessionStorage.getItem(UNFOLD_STORAGE_PEAK);
          if (peak) {
            document.documentElement.style.setProperty("--hp-unfold-peak", peak);
          }
        } catch {
          // sessionStorage unavailable — the expand keyframes fall
          // back to their default peak.
        }
        // Back/forward scroll restoration: the router calls a plain
        // scrollTo at swap time, which (a) obeys the site's
        // scroll-behavior: smooth — a multi-hundred-ms glide instead
        // of a jump — and (b) runs before Lit elements have produced
        // their first shadow render, so the still-collapsed page can
        // clamp it. Re-apply the entry's stored position after the
        // pending element updates flush (same microtask drain,
        // still before first paint), instantly — which also cancels
        // the router's in-flight glide. Forward navigations store
        // 0/0 on their fresh entry, so this is a no-op for them.
        const stored = history.state as { scrollX?: number; scrollY?: number } | null;
        if (stored && typeof stored.scrollY === "number" && typeof stored.scrollX === "number") {
          const { scrollX: left, scrollY: top } = stored;
          queueMicrotask(() => {
            if (window.scrollX !== left || window.scrollY !== top) {
              scrollTo({ left, top, behavior: "instant" });
            }
          });
        }
      });

      // ── Sidebar prefetch ──────────────────────────────────────
      // Astro's prefetch strategies scan light-DOM anchors only
      // (document.getElementsByTagName), so the sidebar's shadow-DOM
      // links are invisible to them. Prefetch what the sidebar has
      // actually revealed instead: every item outside a collapsed
      // group on arrival, and each group's items the moment it
      // expands — hp-sidebar-group reflects its <details> state onto
      // the host's `open` attribute, which the mutation observer
      // below watches. Attribute-driven rather than an
      // IntersectionObserver: the collapse is a closed <details>,
      // whose contents keep geometry, so intersection would
      // misreport them as visible.
      const prefetchedSidebar = new Set<string>();

      function revealedItems(root: ParentNode): HTMLElement[] {
        return [...root.querySelectorAll<HTMLElement>("hp-sidebar-item[href]")].filter((item) => {
          for (let el = item.parentElement; el; el = el.parentElement) {
            if (el.tagName.toLowerCase() === "hp-sidebar") {
              break;
            }
            if (el.tagName.toLowerCase() === "hp-sidebar-group" && !el.hasAttribute("open")) {
              return false;
            }
          }
          return true;
        });
      }

      function prefetchRevealed(root: ParentNode): void {
        for (const item of revealedItems(root)) {
          const itemHref = item.getAttribute("href");
          if (!itemHref || item.hasAttribute("active") || prefetchedSidebar.has(itemHref)) {
            continue;
          }
          prefetchedSidebar.add(itemHref);
          prefetch(itemHref);
        }
      }

      const sidebarExpansion = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          const group = mutation.target as HTMLElement;
          if (group.hasAttribute("open")) {
            prefetchRevealed(group);
          }
        }
      });

      function wireSidebarPrefetch(): void {
        const sidebar = document.querySelector(".page-sidebar");
        if (!sidebar) {
          return;
        }
        // Fresh sidebar every navigation — re-attach wholesale.
        sidebarExpansion.disconnect();
        sidebarExpansion.observe(sidebar, {
          attributes: true,
          attributeFilter: ["open"],
          subtree: true,
        });
        prefetchRevealed(sidebar);
      }

      // Fires on the initial load and after every router navigation,
      // once the new page's scripts have run.
      document.addEventListener("astro:page-load", () => {
        rebuildTOC();
        playReverseArrival();
        wireSidebarPrefetch();
        routerNavDirection = null;
      });
    </script>
  </body>
</html>
