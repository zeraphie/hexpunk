---
// PerfStats.astro — the "show stats" performance disclosure.
//
// The measured-cost table heavy components surface in their docs
// page's notice slot (visible on every tab), tucked behind a small
// hexpunk-styled trigger. One component so every page's stats read
// identically; rows are data. Bundle-size rows come from
// `bun run stats` (tools/build-stats.ts → data/perf-stats.json), so
// those figures regenerate rather than go stale; runtime rows
// (initialisation, per-frame cost) are profiled by hand in a real
// browser and dated by their prose.

interface Row {
  cost: string;
  /** May carry entities (`&nbsp;`) — rendered as HTML. */
  measured: string;
  context: string;
}

const { rows } = Astro.props as { rows: Row[] };
---

<hp-banner tone="warn" class="perf-banner">
  This is one of hexpunk's heavier components and can affect page performance — keep
  hardware acceleration on for the best experience.
</hp-banner>

<hp-collapsible class="perf-collapsible">
  <button slot="trigger" class="stats-trigger" type="button">
    <hp-cell variant="action" size="xxs" aria-hidden="true">
      <hp-pixel class="stats-pixel" type="expandable" pixel-size="2"></hp-pixel>
    </hp-cell>
    <span class="stats-label">
      <span class="when-closed">show stats</span>
      <span class="when-open">hide stats</span>
    </span>
  </button>
  <hr class="hp-separator" />
  <table class="perf-status">
    <thead>
      <tr>
        <th scope="col">Cost</th>
        <th scope="col">Measured</th>
        <th scope="col">Context</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td set:html={row.cost} />
            <td set:html={row.measured} />
            <td set:html={row.context} />
          </tr>
        ))
      }
    </tbody>
  </table>
  <hr class="hp-separator" />
</hp-collapsible>

<style>
  /* The standard heavy-component advisory, above the disclosure so
   * it reads before anyone digs into numbers. */
  .perf-banner {
    display: block;
    margin-block-end: var(--hp-md, 16px);
  }

  /* Muted status readout — informational, not a focal element,
   * tucked behind a small "show stats" disclosure. */
  .perf-status {
    font-size: 0.85rem;
    color: var(--hp-on-surface-variant);
  }

  .perf-collapsible hr.hp-separator:first-of-type {
    margin-bottom: 32px;
  }

  .perf-collapsible hr.hp-separator:last-of-type {
    margin-block: 32px;
  }

  /* One native button is the whole trigger — hex, pixel morph, and
   * label share a single hitbox, hover surface, and focus stop. The
   * hex is presentational (hp-cell, not hp-button — no nested
   * buttons); the label lives beside it, never inside, per the
   * inline-control-tier pattern. */
  .stats-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--hp-xs, 8px);
    padding: var(--hp-xxs, 4px);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--hp-on-surface-variant);
  }

  .stats-trigger:hover,
  .stats-trigger:focus-visible {
    color: var(--hp-on-surface);
  }

  .stats-trigger:focus-visible {
    outline: 2px solid var(--hp-primary);
    outline-offset: 2px;
  }

  .stats-label {
    white-space: nowrap;
    font-family: var(--hp-typo-label-sm-font-family);
    font-size: var(--hp-typo-label-sm-font-size);
    font-weight: var(--hp-typo-label-sm-font-weight);
    letter-spacing: var(--hp-typo-label-sm-letter-spacing);
    text-transform: uppercase;
  }

  .stats-label .when-open,
  .stats-trigger[aria-expanded="true"] .when-closed {
    display: none;
  }

  .stats-trigger[aria-expanded="true"] .when-open {
    display: inline;
  }

  /* Pixel morph rides the BUTTON's state, not its own: rest is the
   * square (idle), row-hover fans to the plus, press-and-hold or
   * expanded rotates to the cross. The state vars are published by
   * hp-pixel; the page just picks which one the shadow shows. */
  .stats-trigger:hover .stats-pixel,
  .stats-trigger:focus-visible .stats-pixel {
    --hp-pixel-shadow: var(--hp-pixel-hover);
  }

  .stats-trigger:active .stats-pixel,
  .stats-trigger[aria-expanded="true"] .stats-pixel {
    --hp-pixel-shadow: var(--hp-pixel-active);
  }
</style>
