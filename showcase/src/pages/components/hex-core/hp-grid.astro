</style>

<script>
  import {
    HexEngine,
    axialToWorld,
    hexHeight,
    hexWidth,
    placeCell,
    readTokenColor,
    ThemeWatcher,
    type AxialCoord,
    type EngineSkin,
    type WorldRect,
  } from "../../../../../src/engine/index.ts";
  import { onPageVisit } from "../../../lib/visit.ts";
  const TIER_THRESHOLDS = [100, 240, 520];
  const REDIVE_COOLDOWN_MS = 600;
  /** Hex side the cell typography is designed against; other sizes
   * counter-scale through --pg-k so apparent text size is stable. */
  const BASE_HEX_SIDE = 64;
  /** Tight row-major pack width for the six demo cells. */
  const ROW_WIDTH = 4;
  /** Fallback sm hex-cell width when the token is unavailable. */
  const FALLBACK_CELL_WIDTH = 100;
  /** Tour stops as APPARENT hex widths. */
  const TOUR_APPARENT = [110, 180, 350, 900, 110];

  type LayoutName = "free" | "spiral" | "rows";

  interface PlaygroundNode {
    kind: "dossier" | "category";
    q: number;
    r: number;
    name: string;
    role: string;
    stats?: [string, string][];
    desc?: string;
    count?: number;
    preview?: string[];
    page?: string;
    cell: AxialCoord;
    rect: WorldRect;
    el: HTMLElement;
  }

  // The document persists across client-router navigations, so this
  // module runs once per session while the playground's DOM is torn
  // down and rebuilt on every visit. Element references and
  // per-visit state are (re)assigned in setup() — nothing may
  // capture a node at module scope or it goes stale after the first
  // navigation away.
  let stage!: HTMLElement;
  let overlay!: HTMLElement;
  let hud!: { z: HTMLElement; px: HTMLElement; tier: HTMLElement; cells: HTMLElement };
  let eventList!: HTMLElement;
  let canvas!: HTMLCanvasElement;

  interface PlaygroundSettings {
    layout: LayoutName;
    draggable: boolean;
    tetherable: boolean;
    directed: boolean;
    diveFraction: number;
    instant: boolean;
  }
  let prefersReduced = false;
  let settings!: PlaygroundSettings;

  /** Arcs the demo starts with — the hub wired to its feeds. */
  const SEED_TETHERS: [string, string][] = [
    ["RELAY-07", "ARCHIVE-3"],
    ["SENTRY-K", "ARCHIVE-3"],
  ];

  let engine: HexEngine | null = null;
  let nodes: PlaygroundNode[] = [];
  let nodeById = new Map<string, PlaygroundNode>();
  let side = BASE_HEX_SIDE;
  let divedNode: PlaygroundNode | null = null;
  let lastSurfaceAt = 0;

  /** The grid has no size prop — camera zoom subsumes it — so the
   * world is pitched once from the sm cell token. */
  function hexSideFor(): number {
    const raw = getComputedStyle(stage).getPropertyValue("--hp-hex-cell-sm");
    const width = Number.parseFloat(raw) || FALLBACK_CELL_WIDTH;
    return width / Math.sqrt(3);
  }

  function buildSkin(): EngineSkin {
    const stroke = readTokenColor(stage, "--hp-outline-variant", "#2a4955");
    const bright = readTokenColor(stage, "--hp-outline", "#0088cc");
    // Arcs take the secondary hue, matching hp-tether's own palette.
    const arc = readTokenColor(stage, "--hp-secondary", "#00cc88");
    const arcIdle = readTokenColor(stage, "--hp-secondary-container", "#005b3d");
    return {
      strokeColor: stroke.color,
      strokeAlpha: stroke.alpha,
      strokeWidth: 1.5,
      highlightColor: bright.color,
      highlightWidth: 2.5,
      tetherColor: arc.color,
      tetherIdleColor: arcIdle.color,
      tetherWidth: 2,
      tetherArrowSize: 11,
    };
  }

  function logEvent(type: string, detail: string, coalesce = false): void {
    const last = eventList.firstElementChild as HTMLElement | null;
    if (coalesce && last?.dataset.type === type) {
      last.querySelector(".pg-event-detail")!.textContent = detail;
      return;
    }
    const entry = document.createElement("li");
    entry.dataset.type = type;
    entry.innerHTML = `<span class="pg-event-type">${type}</span><span class="pg-event-detail">${detail}</span>`;
    eventList.prepend(entry);
    while (eventList.children.length > 9) {
      eventList.lastElementChild!.remove();
    }
  }
  const cellLabel = (cell: { q: number; r: number }) => `(${cell.q}, ${cell.r})`;

  const logRows: [string, string, string?][] = [
    ["04:12:07", "lattice sync ok — 14 peers"],
    ["04:11:52", "shard 8841 sealed → ARCHIVE-3"],
    ["04:11:31", "route table rebalanced (west spur)"],
    ["04:10:58", "peer NODE-2F latency 12ms → 9ms"],
    ["04:10:44", "token grant: SENTRY-K scan tick"],
    ["04:09:12", "warn: peer NODE-71 jitter above band", "warn"],
    ["04:08:55", "lattice sync ok — 14 peers"],
    ["04:08:20", "shard 8840 sealed → ARCHIVE-3"],
    ["04:07:44", "uplink window rotated (sector 9)"],
    ["04:07:02", "peer NODE-4A rejoined after 38s"],
    ["04:06:31", "warn: archive consent latency 402ms", "warn"],
    ["04:05:58", "lattice sync ok — 13 peers"],
  ];
  const peerRows: [string, string, string][] = [
    ["NODE-2F", "9 ms", "linked"],
    ["NODE-4A", "14 ms", "linked"],
    ["NODE-71", "31 ms", "jitter"],
    ["NODE-0C", "11 ms", "linked"],
    ["NODE-9B", "18 ms", "linked"],
    ["NODE-D2", "24 ms", "linked"],
    ["NODE-55", "—", "dormant"],
    ["NODE-E8", "12 ms", "linked"],
  ];
  const configRows: [string, string][] = [
    ["sync.interval", "3600 s"],
    ["sync.window", "00:00–00:04"],
    ["mesh.max_peers", "16"],
    ["mesh.failover", "RELAY-04"],
    ["archive.target", "ARCHIVE-3"],
    ["archive.consent", "dual-key"],
    ["watchdog", "SENTRY-K"],
    ["watchdog.scan", "4 Hz"],
    ["region.lock", "sector 9"],
    ["fw.channel", "beta"],
  ];

  const nodeDefs: Omit<PlaygroundNode, "cell" | "rect" | "el">[] = [
    {
      kind: "dossier",
      q: 0,
      r: 0,
      name: "RELAY-07",
      role: "mesh uplink",
      stats: [
        ["uptime", "312d 04h"],
        ["peers", "14"],
        ["throughput", "2.4 GB/s"],
        ["region", "sector 9"],
      ],
      desc: "Primary uplink for the sector-9 mesh. Carries lattice sync for every node in the western spur; failover pair with RELAY-04. Neighbouring cells hold its live feeds.",
    },
    {
      kind: "dossier",
      q: -2,
      r: 3,
      name: "SENTRY-K",
      role: "watchdog",
      stats: [
        ["uptime", "312d 04h"],
        ["alerts", "0 active"],
        ["scan rate", "4 Hz"],
        ["region", "sector 9"],
      ],
      desc: "Perimeter watchdog. Samples edge traffic on the axial ring and revokes tokens on anomaly; consent partner for ARCHIVE-3.",
    },
    {
      kind: "dossier",
      q: 3,
      r: -1,
      name: "ARCHIVE-3",
      role: "cold storage",
      stats: [
        ["uptime", "89d 11h"],
        ["shards", "1,204"],
        ["integrity", "99.97%"],
        ["region", "sector 9"],
      ],
      desc: "Write-once shard vault. Accepts lattice snapshots on the hour; retrieval requires dual-key consent from SENTRY-K.",
    },
    {
      kind: "category",
      q: 1,
      r: 0,
      name: "LOGS",
      role: "live feed",
      count: 247,
      preview: logRows.slice(0, 3).map(([at, msg]) => `${at} ${msg}`),
      page: `<h3>relay-07 · event stream</h3>${logRows
        .map(
          ([at, msg, warn]) =>
            `<div class="pg-log${warn ? " pg-warn" : ""}"><span class="pg-ts">${at}</span><span class="pg-msg">${msg}</span></div>`
        )
        .join("")}<h3>notes</h3><p>Stream is tail-first; older events page in as the feed scrolls. Warnings stay pinned to the anomaly digest until SENTRY-K acknowledges them.</p>`,
    },
    {
      kind: "category",
      q: -1,
      r: 1,
      name: "PEERS",
      role: "mesh table",
      count: 14,
      preview: peerRows.slice(0, 3).map(([id, latency]) => `${id} · ${latency}`),
      page: `<h3>relay-07 · peer table</h3><div class="pg-rows">${peerRows
        .map(
          ([id, latency, state]) =>
            `<div class="pg-row"><span>${id}</span><span>${latency}</span><span class="pg-v">${state}</span></div>`
        )
        .join("")}</div><h3>topology</h3><p>Peers are ranked by axial distance on the lattice, not raw latency — the mesh prefers short lattice hops even when a longer hop is momentarily faster, because hop-local failure domains stay recoverable.</p>`,
    },
    {
      kind: "category",
      q: 0,
      r: -1,
      name: "CONFIG",
      role: "node policy",
      count: 10,
      preview: configRows.slice(0, 3).map(([key, value]) => `${key} = ${value}`),
      page: `<h3>relay-07 · active policy</h3><div class="pg-rows">${configRows
        .map(
          ([key, value]) =>
            `<div class="pg-row"><span>${key}</span><span class="pg-v">${value}</span></div>`
        )
        .join("")}</div><h3>provenance</h3><p>Policy is written by the sector controller and countersigned by SENTRY-K. Local edits are staged as a shadow policy until the next sync window, then either promoted or discarded by quorum.</p>`,
    },
  ];

  /** Axial ring-walk directions, matching the lattice's neighbour
   * order. Used to grow the tight spiral outward. */
  const RING_DIRS: [number, number][] = [
    [1, 0],
    [1, -1],
    [0, -1],
    [-1, 0],
    [-1, 1],
    [0, 1],
  ];

  /** Tight spiral: centre, then adjacent rings outward — no gap.
   * hp-grid's shipped packers keep a ≥1-hex gap because they place
   * whole clusters; for single hexes that reads as scattered, so
   * the demo packs adjacent (flagged for the rework: the gap
   * should likely be mask-aware or a knob). */
  function tightSpiral(count: number): AxialCoord[] {
    const out: AxialCoord[] = [{ q: 0, r: 0 }];
    for (let ring = 1; out.length < count; ring++) {
      let q = -ring;
      let r = ring;
      for (let dir = 0; dir < 6 && out.length < count; dir++) {
        for (let step = 0; step < ring && out.length < count; step++) {
          out.push({ q, r });
          q += RING_DIRS[dir]![0];
          r += RING_DIRS[dir]![1];
        }
      }
    }
    return out;
  }

  /** Tight rows: reading order, `ROW_WIDTH` per row, centred on the
   * origin (r/2 compensation keeps rows visually stacked). */
  function tightRows(count: number): AxialCoord[] {
    const out: AxialCoord[] = [];
    for (let i = 0; i < count; i++) {
      const r = Math.floor(i / ROW_WIDTH);
      const q = (i % ROW_WIDTH) - Math.floor(ROW_WIDTH / 2) - Math.floor(r / 2);
      out.push({ q, r });
    }
    return out;
  }

  /** Cell assignment per layout mode. `free` honours the authored
   * q/r; the packed modes assign in definition order. */
  function layoutCells(): Map<string, AxialCoord> {
    const assigned = new Map<string, AxialCoord>();
    if (settings.layout === "free") {
      for (const def of nodeDefs) {
        assigned.set(def.name, { q: def.q, r: def.r });
      }
      return assigned;
    }
    const packed =
      settings.layout === "spiral" ? tightSpiral(nodeDefs.length) : tightRows(nodeDefs.length);
    nodeDefs.forEach((def, index) => {
      assigned.set(def.name, packed[index]!);
    });
    return assigned;
  }

  function buildCell(
    def: Omit<PlaygroundNode, "cell" | "rect" | "el">,
    cell: AxialCoord
  ): PlaygroundNode {
    const [cx, cy] = axialToWorld(cell.q, cell.r, side);
    const rect: WorldRect = { cx, cy, w: hexWidth(side), h: hexHeight(side) };
    const el = document.createElement("div");
    el.className = "pg-cell";
    placeCell(el, rect);

    const t1Extra =
      def.kind === "category" ? `<span class="pg-count">${def.count} items</span>` : "";
    let t2 = "";
    let t3 = "";
    let t4 = "";
    if (def.kind === "category") {
      t2 = `<h2>${def.name}</h2><div class="pg-role">category · ${def.count} items</div><div class="pg-preview">${def.preview!.join("<br/>")}</div>`;
      t3 = `<div class="pg-cap"><h2>${def.name}</h2><div class="pg-role">category · ${def.count} items</div></div><div class="pg-band" style="display:grid;place-content:center;text-align:center"><div class="pg-preview-mid">${def.preview!.join("<br/>")}</div></div><div class="pg-base"><span class="pg-hint">keep zooming to dive ▸</span></div>`;
      t4 = `<div class="pg-cap"><h2>RELAY-07 / ${def.name}</h2><div class="pg-role">${def.role}</div></div><div class="pg-band"><div class="pg-skel"><div class="pg-bar"></div><div class="pg-bar"></div><div class="pg-bar"></div><div class="pg-bar"></div><div class="pg-bar"></div></div><div class="pg-content">${def.page!}</div></div><div class="pg-base">esc or zoom out to close</div>`;
    } else {
      t2 = `<h2>${def.name}</h2><div class="pg-role">${def.role}</div><div class="pg-stats">${def.stats![0]![0]} ${def.stats![0]![1]} · ${def.stats![1]![0]} ${def.stats![1]![1]}</div>`;
      t3 = `<div class="pg-cap"><h2>${def.name}</h2><div class="pg-role">${def.role} · sector 9</div></div><div class="pg-band"><p>${def.desc!}</p><table>${def.stats!.map(([key, value]) => `<tr><td>${key}</td><td>${value}</td></tr>`).join("")}</table></div><div class="pg-base">last sync 00:04:12 ago</div>`;
    }
    el.innerHTML = `<div class="pg-tier pg-t1"><div><div><span class="pg-dot"></span>${def.name}</div>${t1Extra}</div></div><div class="pg-tier pg-t2">${t2}</div><div class="pg-tier pg-t3">${t3}</div>${t4 ? `<div class="pg-tier pg-t4">${t4}</div>` : ""}`;
    overlay.appendChild(el);
    return { ...def, cell, rect, el };
  }

  /** Zoom-as-navigation: zooming a category past dived scale
   * with the cell in view opens it. Only a live user zoom counts
   * as intent — a tween flying back out of a page passes through
   * dived scale and must not re-open the cell it just left. */
  function maybeAutoDive(zoom: number): void {
    if (!engine || engine.dived || engine.animating) {
      return;
    }
    if (performance.now() - lastSurfaceAt < REDIVE_COOLDOWN_MS) {
      return;
    }
    const width = stage.clientWidth;
    const height = stage.clientHeight;
    if (hexWidth(side) * zoom < width * settings.diveFraction) {
      return;
    }
    const cam = engine.cameraState;
    for (const node of nodes) {
      if (node.kind !== "category") {
        continue;
      }
      const sx = node.rect.cx * cam.z + cam.x;
      const sy = node.rect.cy * cam.z + cam.y;
      if (sx > width * 0.2 && sx < width * 0.8 && sy > height * 0.1 && sy < height * 0.9) {
        diveInto(node);
        return;
      }
    }
  }

  function diveInto(node: PlaygroundNode): void {
    if (!engine) {
      return;
    }
    divedNode = node;
    logEvent("dive", `into ${node.name}`);
    engine.diveInto(node.rect);
    // pjax stand-in: the cap renders instantly from tier-1 data,
    // the band arrives after a simulated fetch.
    node.el.classList.add("pg-loading");
    setTimeout(() => {
      node.el.classList.remove("pg-loading");
    }, 600);
  }

  /** Rebuild cells + engine from the current settings. Size and
   * motion changes come through here — the canvas is replaced so
   * the fresh renderer never inherits a dead GL context. */
  async function boot(visit: AbortSignal): Promise<void> {
      engine?.destroy();
      engine = null;
      divedNode = null;
      overlay.innerHTML = "";
      const fresh = document.createElement("canvas");
      fresh.id = "pg-canvas";
      canvas.replaceWith(fresh);
      canvas = fresh;

      stage.dataset.pgMotion = settings.instant ? "instant" : "animated";
    side = hexSideFor();
      overlay.style.setProperty("--pg-k", String(side / BASE_HEX_SIDE));
      const cells = layoutCells();
      nodes = nodeDefs.map((def) => buildCell(def, cells.get(def.name)!));
      nodeById = new Map(nodes.map((node) => [node.name, node]));

      engine = await HexEngine.create({
        host: stage,
        canvas,
        overlay,
        hexSide: side,
        skin: buildSkin(),
        minZoom: 0.2,
        maxZoom: 14,
        tierThresholds: TIER_THRESHOLDS,
        diveFraction: settings.diveFraction,
        draggable: settings.draggable,
        tetherable: settings.tetherable,
        instant: settings.instant,
        onOccupantPosition(id, wx, wy) {
          const node = nodeById.get(id);
          if (node) {
            node.rect.cx = wx;
            node.rect.cy = wy;
            placeCell(node.el, node.rect);
          }
        },
        onDragStart(id) {
          nodeById.get(id)?.el.classList.add("pg-dragging");
          stage.dataset.pgDrag = "active";
          logEvent("drag", `${id} picked up`);
        },
        onMove({ id, from, to }) {
          const node = nodeById.get(id);
          if (node) {
            node.cell = to;
          }
          logEvent("move", `${id} ${cellLabel(from)} → ${cellLabel(to)}`);
        },
        onDrop({ id, at }) {
          nodeById.get(id)?.el.classList.remove("pg-dragging");
          delete stage.dataset.pgDrag;
          logEvent("drop", `${id} settled at ${cellLabel(at)}`);
        },
        onBond({ id, partner }) {
          logEvent("bond", `${id} ↔ ${partner}`);
        },
        onUnbond({ id, partner }) {
          logEvent("unbond", `${id} ↮ ${partner}`);
        },
        onTether({ tether }) {
          logEvent("tether", `${tether.from} → ${tether.to}`);
        },
        onUntether({ tether }) {
          logEvent("untether", `${tether.from} ⇥ ${tether.to}`);
        },
        onPan() {
          if (engine) {
            const cam = engine.cameraState;
            logEvent("pan", `camera at (${Math.round(cam.x)}, ${Math.round(cam.y)})`, true);
          }
        },
        onActivate({ occupant }) {
          if (!engine || engine.dived || !occupant) {
            return;
          }
          const node = nodeById.get(occupant);
          if (node?.kind === "category") {
            diveInto(node);
          }
        },
        onHoverCell(cell) {
          // Grab cursor only where a drag would actually start.
          const occupant = cell ? engine?.occupancy.occupantAt(cell) : null;
          const node = occupant ? nodeById.get(occupant) : undefined;
          if (occupant && engine?.canDrag(occupant)) {
            stage.dataset.pgHover = "draggable";
          } else if (node?.kind === "category" && !engine?.dived) {
            stage.dataset.pgHover = "divable";
          } else {
            delete stage.dataset.pgHover;
          }
        },
        onCameraChange(state, visibleCells) {
          if (!engine) {
            return;
          }
          hud.z.textContent = state.z.toFixed(2);
          hud.px.textContent = `${Math.round(hexWidth(side) * state.z)}px`;
          hud.cells.textContent = String(visibleCells);
          hud.tier.textContent = engine.dived ? "4 (page)" : String(engine.tier);
          const tier = engine.dived ? 4 : engine.tier;
          for (const node of nodes) {
            node.el.dataset.tier = node === divedNode ? "4" : String(tier);
          }
          maybeAutoDive(state.z);
        },
        onDiveChange(dived) {
          if (!dived) {
            logEvent("surface", `from ${divedNode?.name ?? "?"}`);
            divedNode?.el.classList.remove("pg-loading");
            divedNode = null;
            lastSurfaceAt = performance.now();
          }
        },
      });

      if (visit.aborted) {
        // The visitor left while the engine was still initialising;
        // discard the newborn.
        engine.destroy();
        engine = null;
        return;
      }

      // Dossiers follow the host `draggable` flag; the hub's
      // category satellites are pinned — the per-cell override
      // hp-grid expresses as draggable="false".
      for (const node of nodes) {
        engine.addOccupant({
          id: node.name,
          cell: node.cell,
          draggable: node.kind === "category" ? false : undefined,
        });
      }
      engine.defaultDirected = settings.directed;
      for (const [from, to] of SEED_TETHERS) {
        engine.addTether(from, to);
      }
    engine.jumpTo(1, 0, 0);
    console.log("[playground] renderer:", engine.rendererString);
  }

  /** Boots run one after another: every click lands, and the last
   * one wins because each boot reads the current settings. */
  let bootChain: Promise<void> = Promise.resolve();
  function scheduleBoot(visit: AbortSignal): void {
    bootChain = bootChain.then(() => boot(visit)).catch((error) => {
      console.error("[playground] boot failed", error);
    });
  }

  /** Re-place occupants for a layout change without a full engine
   * rebuild — mirrors hp-grid's pack() re-running on `layout`. */
  function applyLayout(): void {
    if (!engine) {
      return;
    }
    const cells = layoutCells();
    for (const node of nodes) {
      const cell = cells.get(node.name)!;
      node.cell = cell;
      const [cx, cy] = axialToWorld(cell.q, cell.r, side);
      node.rect.cx = cx;
      node.rect.cy = cy;
      placeCell(node.el, node.rect);
    }
    engine.placeOccupants(nodes.map((node) => [node.name, node.cell] as const));
    // Fit-to-content recentre, like hp-grid's pack() → recenter().
    const cx = nodes.reduce((sum, node) => sum + node.rect.cx, 0) / nodes.length;
    const cy = nodes.reduce((sum, node) => sum + node.rect.cy, 0) / nodes.length;
    engine.flyTo(engine.cameraState.z, cx, cy);
    logEvent("layout", `packed as ${settings.layout}`);
  }

  /** Shrink each control label until it fits inside its hex —
   * hp-button's fixed-size hex happily overflows long words
   * ("animated" bleeds into the neighbour at the default size).
   * A proper fit-to-shape label belongs to the form-atom rework;
   * this keeps the dev panel legible meanwhile. */
  function fitPanelLabels(): void {
    // hp-cell pins the xs label to the --hp-typo-label-sm-* tokens
    // inside its shadow (uppercase + tracking), so the fit must
    // measure that exact face and override the size TOKEN — custom
    // properties pierce the shadow where host font-size cannot.
    const measurer = document.createElement("canvas").getContext("2d")!;
    for (const button of document.querySelectorAll<HTMLElement>(".pg-hud hp-button")) {
      const label = (button.textContent?.trim() ?? "").toUpperCase();
      if (!label) {
        continue;
      }
      const style = getComputedStyle(button);
      const family = style.getPropertyValue("--hp-typo-label-sm-font-family").trim() || "monospace";
      const weight = style.getPropertyValue("--hp-typo-label-sm-font-weight").trim() || "400";
      const base = Number.parseFloat(style.getPropertyValue("--hp-typo-label-sm-font-size")) || 12;
      const trackingRaw = style.getPropertyValue("--hp-typo-label-sm-letter-spacing").trim();
      const tracking = trackingRaw.endsWith("em")
        ? Number.parseFloat(trackingRaw) * base
        : Number.parseFloat(trackingRaw) || 0;
      const safeWidth = (Number.parseFloat(style.width) || 32) * 0.8;
      measurer.font = `${weight} ${base}px ${family}`;
      const textWidth = measurer.measureText(label).width + tracking * label.length;
      if (textWidth > safeWidth) {
        // em tracking shrinks with the font, so one linear pass fits.
        const fitted = Math.max(6, Math.floor(base * (safeWidth / textWidth)));
        button.style.setProperty("--hp-typo-label-sm-font-size", `${fitted}px`);
      }
    }
  }

  function wireGroup(id: string, apply: (value: string) => void): void {
    const container = document.getElementById(id)!;
    container.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest("hp-button");
      if (!button || button.hasAttribute("disabled") || !container.contains(button)) {
        return;
      }
      for (const sibling of container.querySelectorAll("hp-button")) {
        sibling.removeAttribute("aria-pressed");
      }
      button.setAttribute("aria-pressed", "true");
      apply((button as HTMLElement).dataset.value!);
    });
  }

  function viewCentreWorld(): [number, number] {
    const cam = engine!.cameraState;
    return [(stage.clientWidth / 2 - cam.x) / cam.z, (stage.clientHeight / 2 - cam.y) / cam.z];
  }

  /** Un-clip only once the panel has finished opening: tooltips on the
   * lower rows need to escape the box, but the collapse animation
   * needs the clip to read as a collapse. Timed rather than driven by
   * transitionend, which never fires when motion is instant. */
  const HUD_COLLAPSE_MS = 240;
  let hudBody!: HTMLElement;
  let hudSettle: number | undefined;
  let tourStep = 0;
  function setHudOpen(open: boolean): void {
    window.clearTimeout(hudSettle);
    hudBody.inert = !open;
    if (!open) {
      delete hudBody.dataset.open;
      return;
    }
    hudSettle = window.setTimeout(() => {
      hudBody.dataset.open = "";
    }, HUD_COLLAPSE_MS);
  }

  let themeWatcher: ThemeWatcher | null = null;

  // Query this visit's DOM and wire every control; the teardown stops
  // everything that would outlive it — the engine's render loop and
  // the theme watcher hold on to a canvas the next page no longer
  // contains.
  onPageVisit((visit) => {
    const nextStage = document.getElementById("pg-stage");
    if (!nextStage) {
      return;
    }
    stage = nextStage;
    overlay = document.getElementById("pg-overlay")!;
    hud = {
      z: document.getElementById("pg-z")!,
      px: document.getElementById("pg-px")!,
      tier: document.getElementById("pg-tier")!,
      cells: document.getElementById("pg-cells")!,
    };
    eventList = document.getElementById("pg-events")!;
    canvas = document.getElementById("pg-canvas") as HTMLCanvasElement;

    prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    settings = {
      layout: "free",
      draggable: true,
      tetherable: true,
      directed: false,
      diveFraction: 0.55,
      instant: prefersReduced,
    };
    divedNode = null;
    lastSurfaceAt = 0;
    tourStep = 0;

    wireGroup("pg-layout", (value) => {
      settings.layout = value as LayoutName;
      applyLayout();
    });
    wireGroup("pg-draggable", (value) => {
      settings.draggable = value === "on";
      if (engine) {
        engine.draggable = settings.draggable;
      }
      // The cursor is refreshed on hover; clear it so a stale grab
      // doesn't linger over a cell that just became fixed.
      delete stage.dataset.pgHover;
      logEvent("draggable", settings.draggable ? "host flag on" : "host flag off");
    });
    wireGroup("pg-dive", (value) => {
      settings.diveFraction = Number(value);
      engine?.setDiveFraction(settings.diveFraction);
      logEvent("dive at", `${Math.round(settings.diveFraction * 100)}% of viewport`);
    });
    wireGroup("pg-motion", (value) => {
      settings.instant = value === "instant" || prefersReduced;
      stage.dataset.pgMotion = settings.instant ? "instant" : "animated";
      scheduleBoot(visit);
    });
    wireGroup("pg-tetherable", (value) => {
      settings.tetherable = value === "on";
      if (engine) {
        engine.tetherable = settings.tetherable;
      }
      logEvent(
        "tetherable",
        settings.tetherable
          ? `graph layer on — ${engine?.tethers.size ?? 0} arc(s) shown, drops toggle arcs`
          : "graph layer off — arcs hidden, drops move cells"
      );
    });
    wireGroup("pg-directed", (value) => {
      settings.directed = value === "on";
      if (!engine) {
        return;
      }
      // Arrowheads are a per-arc flag, so patch the live defs rather
      // than rebuilding the world around them.
      engine.defaultDirected = settings.directed;
      for (const tether of engine.tethers.list()) {
        tether.directed = settings.directed;
      }
      engine.requestRender();
      logEvent("directed", settings.directed ? "arrowheads on" : "arrowheads off");
    });

    document.getElementById("pg-zoom-in")!.addEventListener("click", () => {
      if (engine) {
        const [wx, wy] = viewCentreWorld();
        engine.flyTo(Math.min(14, engine.cameraState.z * 1.4), wx, wy);
      }
    });
    document.getElementById("pg-zoom-out")!.addEventListener("click", () => {
      if (engine) {
        engine.surface();
        const [wx, wy] = viewCentreWorld();
        engine.flyTo(Math.max(0.2, engine.cameraState.z / 1.4), wx, wy);
      }
    });
    document.getElementById("pg-reset")!.addEventListener("click", () => {
      engine?.surface();
      engine?.flyTo(1, 0, 0);
    });
    document.getElementById("pg-centre")!.addEventListener("click", () => {
      if (!engine || nodes.length === 0) {
        return;
      }
      engine.surface();
      let minX = Infinity;
      let minY = Infinity;
      let maxX = -Infinity;
      let maxY = -Infinity;
      for (const node of nodes) {
        minX = Math.min(minX, node.rect.cx - node.rect.w / 2);
        maxX = Math.max(maxX, node.rect.cx + node.rect.w / 2);
        minY = Math.min(minY, node.rect.cy - node.rect.h / 2);
        maxY = Math.max(maxY, node.rect.cy + node.rect.h / 2);
      }
      const zoom = Math.max(
        0.2,
        Math.min(1, (stage.clientWidth - 32) / (maxX - minX), (stage.clientHeight - 32) / (maxY - minY))
      );
      engine.flyTo(zoom, (minX + maxX) / 2, (minY + maxY) / 2);
    });
    document.getElementById("pg-tour")!.addEventListener("click", () => {
      if (engine) {
        engine.surface();
        const apparent = TOUR_APPARENT[tourStep % TOUR_APPARENT.length]!;
        tourStep++;
        engine.flyTo(apparent / hexWidth(side), 0, 0);
      }
    });

    const hudToggle = document.getElementById("pg-hud-toggle")!;
    hudBody = document.getElementById("pg-hud-body")!;
    const hudMark = hudToggle.querySelector("hp-pixel")!;
    setHudOpen(true);
    hudToggle.addEventListener("click", () => {
      const expanded = hudToggle.getAttribute("aria-expanded") === "true";
      hudToggle.setAttribute("aria-expanded", String(!expanded));
      hudMark.setAttribute("aria-pressed", String(!expanded));
      setHudOpen(expanded === true ? false : true);
    });

    themeWatcher = new ThemeWatcher(() => {
      engine?.setSkin(buildSkin());
    });

    scheduleBoot(visit);
    // Fit after fonts arrive — widths measured against the real face.
    void bootChain.then(() => document.fonts.ready).then(fitPanelLabels);

    return () => {
      window.clearTimeout(hudSettle);
      themeWatcher?.dispose();
      themeWatcher = null;
      engine?.destroy();
      engine = null;
      divedNode = null;
    };
  });
</script>
