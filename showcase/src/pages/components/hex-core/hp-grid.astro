---
import Layout from "../../../layouts/Layout.astro";
import ComponentDocs from "../../../components/ComponentDocs.astro";
import { move, play, rows3, scan, shell, zap } from "../../../../../src/icons/index.ts";

const ICON_SVG_ATTRS = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
};

interface PropOption {
  value: string;
  /** Visible text, or omit when `icon` carries the meaning. */
  text?: string;
  icon?: string;
  pressed?: boolean;
  /** Tooltip body — what picking this option actually does. */
  help: string;
}

interface PropGroup {
  id: string;
  label: string;
  /** Which way the help opens. The lowest rows point up, because a
   * downward tooltip there runs past the stage's clip. */
  side?: "top" | "bottom";
  options: PropOption[];
}

const PROP_GROUPS: PropGroup[] = [
  {
    id: "pg-layout",
    label: "layout",
    options: [
      { value: "free", icon: move, pressed: true, help: "Cells sit at their authored q/r coordinates." },
      { value: "spiral", icon: shell, help: "Packs cells outward from the centre in rings — a tight honeycomb." },
      { value: "rows", icon: rows3, help: "Packs cells in reading order, four to a row." },
    ],
  },
  {
    id: "pg-draggable",
    label: "draggable",
    options: [
      {
        value: "on",
        text: "on",
        pressed: true,
        help: "Dossier cells can be dragged; the bright hex shows where they'll land. Category cells override this and stay pinned.",
      },
      { value: "off", text: "off", help: "Every cell is fixed, so a drag anywhere pans the camera." },
    ],
  },
  {
    id: "pg-dive",
    label: "dive at",
    options: [
      { value: "0.45", text: "45%", help: "A cell becomes a page once it fills 45% of the view — dives sooner." },
      { value: "0.55", text: "55%", pressed: true, help: "Default. Dives at 55% of the view width." },
      { value: "0.7", text: "70%", help: "Needs a deeper zoom before a cell takes over the view." },
    ],
  },
  {
    id: "pg-motion",
    label: "motion",
    side: "top",
    options: [
      {
        value: "animated",
        icon: play,
        pressed: true,
        help: "Everything animates: camera tweens, pan inertia, drag snap, arc draw-in, and the tier crossfades.",
      },
      {
        value: "instant",
        icon: zap,
        help: "Nothing animates — every change jumps to its end state. The same path prefers-reduced-motion takes.",
      },
    ],
  },
  {
    id: "pg-tetherable",
    label: "tetherable",
    side: "top",
    options: [
      {
        value: "on",
        text: "on",
        pressed: true,
        help: "Arcs are drawn, and dropping a cell onto another toggles the arc between that pair.",
      },
      { value: "off", text: "off", help: "Arcs are hidden but kept, and drops move cells again." },
    ],
  },
  {
    id: "pg-directed",
    label: "directed",
    side: "top",
    options: [
      { value: "on", text: "on", help: "Arcs gain an arrowhead at the target end." },
      { value: "off", text: "off", pressed: true, help: "Arcs are plain curves with no direction." },
    ],
  },
];

const HUD_BUTTONS = [
  { id: "pg-reset", text: "reset", help: "Back to 1x at the origin, leaving any dived page." },
  { id: "pg-tour", text: "tour", help: "Fly to the next content tier. Click repeatedly to ride the whole ladder." },
];
import PerfStats from "../../../components/PerfStats.astro";
import perfStats from "../../../data/perf-stats.json";

const kb = (bytes: number) => Math.round(bytes / 1024);

const STATS = [
  {
    cost: "Script (loads with the page)",
    measured: `${kb(perfStats.stats["hp-grid"].static.minifiedBytes)}&nbsp;KB minified · ${kb(
      perfStats.stats["hp-grid"].static.gzippedBytes
    )}&nbsp;KB gzipped`,
    context: "the element and the shared spatial core — what a page pays before any canvas exists",
  },
  {
    cost: "Rendering engine (loads on first use)",
    measured: `${kb(perfStats.stats["hp-grid"].deferred!.minifiedBytes)}&nbsp;KB minified · ${kb(
      perfStats.stats["hp-grid"].deferred!.gzippedBytes
    )}&nbsp;KB gzipped`,
    context: "PixiJS and the renderer, fetched once when the first grid connects; cached afterwards",
  },
  {
    cost: "Initialisation (once, when it connects)",
    measured: "about 35&nbsp;milliseconds",
    context: "creates the WebGL context and builds the field; cells render as plain DOM until then",
  },
  {
    cost: "Animating",
    measured: "0.1 to 0.4&nbsp;milliseconds of CPU time per frame",
    context: "camera movement, drags and arc animations",
  },
  {
    cost: "Idle",
    measured: "0 frames",
    context: "renders only on demand — fully asleep while nothing changes",
  },
];
---

<Layout title="hp-grid">
  <ComponentDocs title="hp-grid">
    <p slot="description">
      Canvas hex viewport — a camera onto a rendered hex world. Slotted children carrying
      <code>q</code> / <code>r</code> ride the camera as live DOM; the field beneath is
      engine-drawn. Pan by dragging empty space or plain wheel, zoom with ctrl/⌘ + wheel,
      drag cells to move them, click to activate. Ships from the
      <code>@hexpunk/core/grid</code> subpath — the rendering engine loads on first connect,
      so nothing else in hexpunk pays for it. Reach for
      <a href="/hexpunk/components/hex-core/hp-layout"><code>&lt;hp-layout&gt;</code></a>
      when the hexes are part of a page instead of a world.
    </p>

    <Fragment slot="notice">
      <PerfStats rows={STATS} />
    </Fragment>

    <p>
      The playground below is the component's engine driving a live world — drag cells onto
      each other for the nearest-free snap, drop one onto another to toggle an arc, zoom
      until the content tiers step, click a cell to dive in (<kbd>Esc</kbd> surfaces). The
      panel's controls are the surface's real knobs, and the event log narrates the
      <code>hp-grid-*</code> stream.
    </p>

    <hp-demo class="pg-demo" caption="hp-grid — pan, zoom, drag, tether, dive">
      <div class="pg-demo-block">
    <div class="pg-stage" id="pg-stage" tabindex="0" aria-label="Hex engine playground">
    <canvas id="pg-canvas"></canvas>
    <div id="pg-overlay"></div>
    <div class="pg-controls">
      <button type="button" aria-label="Zoom out" id="pg-zoom-out">−</button>
      <button type="button" aria-label="Zoom in" id="pg-zoom-in">+</button>
      <button type="button" aria-label="Recenter canvas" id="pg-centre">
        <svg {...ICON_SVG_ATTRS} set:html={scan} />
      </button>
    </div>
    <div class="pg-hud" id="pg-hud">
      <div class="pg-hud-head">
        <div class="pg-hud-readout">zoom <b id="pg-z">1.00</b> · hex <b id="pg-px">0px</b></div>
        <button
          type="button"
          id="pg-hud-toggle"
          class="pg-hud-toggle"
          aria-expanded="true"
          aria-controls="pg-hud-body"
        >
          <hp-pixel
            type="expandable"
            pixel-size="3"
            interactive
            aria-pressed="true"
            aria-hidden="true"
          ></hp-pixel>
          <hp-visually-hidden>Toggle the controls</hp-visually-hidden>
        </button>
      </div>
      <div class="pg-hud-collapse" id="pg-hud-body">
      <div class="pg-hud-inner">
      <div>tier <b id="pg-tier">0</b> · cells <b id="pg-cells">0</b></div>
      <div class="pg-hud-buttons">
        {
          HUD_BUTTONS.map((button) => (
            <hp-tooltip side="bottom">
              <hp-button size="xs" id={button.id}>
                {button.text}
              </hp-button>
              <span slot="content">{button.help}</span>
            </hp-tooltip>
          ))
        }
      </div>
      <div class="pg-props">
        {
          PROP_GROUPS.map((group) => (
            <div class="pg-prop">
              <span class="pg-prop-label">{group.label}</span>
              <span class="pg-prop-options" id={group.id}>
                {group.options.map((option) => (
                  <hp-tooltip side={group.side ?? "bottom"}>
                    <hp-button
                      size="xs"
                      data-value={option.value}
                      aria-pressed={option.pressed ? "true" : undefined}
                      aria-label={option.icon ? option.value : undefined}
                    >
                      {option.icon ? (
                        <svg {...ICON_SVG_ATTRS} set:html={option.icon} />
                      ) : (
                        option.text
                      )}
                    </hp-button>
                    <span slot="content">{option.help}</span>
                  </hp-tooltip>
                ))}
              </span>
            </div>
          ))
        }
      </div>
      </div>
      </div>
    </div>
  </div>

      </div>

      <hp-code slot="code" language="html">{`<body>
  <script type="module">
    // The grid ships from its own subpath; the engine (PixiJS)
    // loads on first connect.
    import "@hexpunk/core/grid";
  <\/script>

  <hp-grid draggable tetherable>
    <hp-cell variant="anchor" filled q="0" r="0" id="relay-07">RELAY-07</hp-cell>
    <hp-cell variant="anchor" q="-2" r="3" id="sentry-k">SENTRY-K</hp-cell>
    <hp-cell variant="anchor" q="3" r="-1" id="archive-3">ARCHIVE-3</hp-cell>

    <!-- Category cells stay pinned while the dossiers drag. -->
    <hp-cell variant="content" size="sm" q="1" r="0" draggable="false">LOGS</hp-cell>
    <hp-cell variant="content" size="sm" q="-1" r="1" draggable="false">PEERS</hp-cell>
    <hp-cell variant="content" size="sm" q="0" r="-1" draggable="false">CONFIG</hp-cell>

    <!-- The arcs this world starts with, drawn on the canvas. -->
    <hp-tether from="#relay-07" to="#archive-3"></hp-tether>
    <hp-tether from="#sentry-k" to="#archive-3"></hp-tether>
  </hp-grid>
</body>`}</hp-code>
    </hp-demo>

  <p class="pg-events-note">
    Event log — newest first; a continuing pan updates its entry rather than flooding the
    list.
  </p>
  <ol class="pg-events" id="pg-events" aria-live="polite"></ol>

    <Fragment slot="intent">
      <h2>hp-grid or hp-layout?</h2>
      <hp-banner tone="do">
        Use <code>&lt;hp-grid&gt;</code> when the hexes are a world you move through —
        camera pan and zoom, a rendered field, semantic tiers, diving into a cell, canvas
        tether arcs. It's meant to be the focal point of its page, ideally near
        full-screen.
      </hp-banner>
      <hp-banner tone="do">
        Use <code>&lt;hp-layout&gt;</code> when the hexes are part of a page — it places
        the same lattice in document flow, sizes to its content, and costs nothing beyond
        the element. Both compose the same spatial core, so drags, snaps and packs resolve
        identically.
      </hp-banner>
      <hp-banner tone="dont">
        Don't scatter several pannable grids through a document. Each one takes the wheel
        while hovered; for illustrations inside prose, set <code>pannable="false"</code> or
        use <code>&lt;hp-layout&gt;</code>.
      </hp-banner>

      <h2>Built on PixiJS</h2>
      <p>
        The field is rendered by <a href="https://pixijs.com">PixiJS</a>, and unlike
        <code>hp-code</code> / <code>hp-latex</code> — which document a consumer-registered
        library and ship no engine — PixiJS is a real bundled dependency of hexpunk. The
        cost is isolated twice over: the element ships only from the
        <code>@hexpunk/core/grid</code> subpath (the root barrel can't reach it, enforced by
        the exports map), and the engine chunk (the deferred cost in the stats above) loads by
        dynamic <code>import()</code> on first connect. Consumers who never render a grid
        never fetch it; buildless CDN consumers need an import map for
        <code>pixi.js</code>.
      </p>

      <p>
        Before the engine lands, slotted cells render immediately as plain DOM at their
        placed positions — the placeholder is the content itself, and the field fades in
        underneath without anything moving.
      </p>

      <h2>Known issue — hardware acceleration off</h2>
      <p>
        With browser hardware acceleration disabled, some software compositors fail to
        repaint the canvas region revealed by scrolling until something triggers a redraw —
        the field can appear cut off after a scroll. The grid stays fully usable (cells are
        DOM; panning or any interaction repaints), and machines with acceleration on are
        unaffected. Accepted as a documented limitation rather than papered over with a
        second render path.
      </p>

      <h2>Accessibility</h2>
      <p>
        Cells are ordinary light-DOM elements: they keep their focusability, focus-visible
        edge trace, and semantics regardless of the canvas underneath. The canvas itself is
        <code>aria-hidden</code>. Camera state is visual-only — keyboard users reach every
        cell in DOM order. Drag-to-move and pan are pointer-only today; don't make either
        the only way to complete a task.
      </p>
    </Fragment>
  </ComponentDocs>
</Layout>


<style is:global>
  /* The element's viewport chrome, mirrored on the stage. */
  .pg-controls {
    position: absolute;
    right: var(--hp-sm);
    bottom: var(--hp-sm);
    z-index: 1;
    display: flex;
    gap: var(--hp-xxs);
    opacity: 0.6;
    transition: opacity var(--hp-duration-fast) var(--hp-ease-default);
  }

  .pg-controls:hover {
    opacity: 1;
  }

  .pg-controls button {
    font: inherit;
    font-size: var(--hp-typo-label-sm-font-size);
    padding: 0 var(--hp-sm);
    background: var(--hp-surface-container);
    color: var(--hp-on-surface);
    border: 1px solid var(--hp-outline-variant);
    border-radius: var(--hp-rounded-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
  }

  .pg-controls button:hover {
    color: var(--hp-secondary);
  }

  .pg-controls svg {
    width: 1rem;
    height: 1rem;
  }

  /* The stage supplies its own chrome, so the demo frame hugs it
     edge to edge. */
  .pg-demo::part(preview) {
    padding: 0;
  }

  /* hp-demo lays its preview out as a flex row; the playground is a
     stacked block (stage, then log). */
  .pg-demo-block {
    display: block;
    width: 100%;
  }

  .pg-events-note {
    margin-block: 0.75rem 0.25rem;
    font-size: var(--hp-typo-label-sm-font-size);
    color: var(--hp-on-surface-variant);
  }

  .pg-stage {
    position: relative;
    height: 72vh;
    min-height: 30rem;
    overflow: hidden;
    background: var(--hp-surface-container-lowest);
  }
  .pg-stage:focus-visible {
    outline: 2px solid var(--hp-outline);
    outline-offset: 2px;
  }
  .pg-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
    touch-action: none;
  }
  /* The overlay never takes pointer events, so a cell can't set its
     own cursor — the canvas wears it, driven by what the engine says
     is under the pointer. */
  .pg-stage[data-pg-hover="draggable"] canvas {
    cursor: grab;
  }
  .pg-stage[data-pg-hover="divable"] canvas {
    cursor: pointer;
  }
  .pg-stage[data-pg-drag="active"] canvas {
    cursor: grabbing;
  }
  #pg-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pg-hud {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.5rem 0.75rem;
    background: color-mix(in srgb, var(--hp-surface-container-lowest) 85%, transparent);
    border: 1px solid var(--hp-outline-variant);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .pg-hud b {
    color: var(--hp-primary-bright);
    font-weight: 400;
  }
  /* The readout and the toggle share one row, so collapsed the panel
     is exactly that row — no reserved space for an absolute button. */
  .pg-hud-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .pg-hud-toggle {
    display: grid;
    place-items: center;
    padding: 0;
    background: none;
    border: none;
    color: var(--hp-on-surface-variant);
    cursor: pointer;
  }
  .pg-hud-toggle:hover {
    color: var(--hp-primary-bright);
  }
  .pg-hud-toggle:focus-visible {
    outline: 2px solid var(--hp-outline);
    outline-offset: 3px;
  }
  /* The pixel art carries the state itself: the panel only moves
     vertically, so the up/down sibling reads correctly — chevron up
     while open (click collapses), dotted square when closed until
     hovered, where it points down (click expands). aria-hidden because
     the button already has a name; aria-pressed is only hp-pixel's CSS
     hook for its toggled frame. */
  .pg-hud-toggle hp-pixel {
    display: block;
    color: inherit;
  }
  /* Animating to height:auto needs a size the browser can interpolate,
     so the region is a single grid row collapsing 1fr → 0fr. `hidden`
     would be display:none and kill the transition, so the collapsed
     state is inert instead. */
  .pg-hud-collapse {
    display: grid;
    grid-template-rows: 1fr;
    overflow: hidden;
    transition:
      grid-template-rows 220ms var(--hp-ease-default, ease),
      opacity 160ms ease;
  }
  .pg-hud-collapse[inert] {
    grid-template-rows: 0fr;
    opacity: 0;
  }
  .pg-hud-collapse[data-open] {
    overflow: visible;
  }
  .pg-hud-inner {
    min-height: 0;
  }

  /* hp-tooltip anchors its body to itself, which is only as wide as
     one button — so long help text ran off the panel and was cut by
     the collapse clip. Neutralising the host's containing block
     re-anchors the body to the row, letting it span the panel's
     content width, centre there, and wrap. */
  .pg-hud hp-tooltip {
    position: static;
  }
  .pg-hud-buttons,
  .pg-prop {
    position: relative;
  }
  .pg-hud hp-tooltip::part(tooltip) {
    left: 0;
    right: 0;
    transform: none;
    white-space: normal;
    text-align: center;
    /* Sentences, not labels — uppercase is unreadable at length. */
    text-transform: none;
    line-height: 1.45;
  }

  .pg-props {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.6rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--hp-outline-faint);
  }
  .pg-prop {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pg-prop-label {
    color: var(--hp-on-surface-variant);
    font-size: 0.75rem;
    min-width: 4.6rem;
  }
  .pg-prop-options {
    display: flex;
    gap: 0.25rem;
  }
  .pg-prop-options hp-button svg {
    display: block;
    width: 14px;
    height: 14px;
  }

  .pg-events {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--hp-outline-variant);
    background: var(--hp-surface-container-lowest);
    font-size: 0.85rem;
    line-height: 1.7;
    min-height: 3.5rem;
    max-width: 60rem;
  }
  .pg-events li {
    display: flex;
    gap: 0.75rem;
    border-bottom: 1px solid var(--hp-outline-faint);
  }
  .pg-events li:last-child {
    border-bottom: none;
  }
  .pg-events .pg-event-type {
    color: var(--hp-primary-bright);
    min-width: 5.5rem;
  }
  .pg-events .pg-event-detail {
    color: var(--hp-on-surface-variant);
  }

  /* ── overlay cells: world-unit layout, hex clip, tier reveal ──
     Cell boxes are sized in world units from the live hex side;
     tier content is designed against the base side and counter-
     scaled via --pg-k so its APPARENT size is identical at every
     `size` setting. */
  /* The fill is a presence marker and never retires: zoomed out past
     every content tier you still see WHERE the occupied cells are,
     which is what makes zooming back in navigable rather than a
     hunt. It stays the same colour at every level — the fill already
     separates a content cell from the lattice, so changing it by
     zoom would read as a state change that hasn't happened. Only the
     content layers and the arcs are tier-gated. */
  .pg-cell {
    position: absolute;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: color-mix(in srgb, var(--hp-surface-container) 88%, transparent);
    transition: background-color 160ms ease;
    --pg-cap: 25%;
    --pg-base: 25%;
  }
  .pg-cell[data-tier="4"] {
    background: color-mix(in srgb, var(--hp-surface-container-lowest) 96%, transparent);
  }
  .pg-cell.pg-dragging {
    z-index: 1;
    opacity: 0.85;
    transition: none;
  }
  .pg-tier {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% / var(--pg-k, 1));
    height: calc(100% / var(--pg-k, 1));
    transform: scale(var(--pg-k, 1));
    transform-origin: 0 0;
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .pg-cell[data-tier="1"] .pg-t1,
  .pg-cell[data-tier="2"] .pg-t2,
  .pg-cell[data-tier="3"] .pg-t3,
  .pg-cell[data-tier="4"] .pg-t4 {
    opacity: 1;
  }

  .pg-cap {
    position: absolute;
    top: 0;
    height: var(--pg-cap);
    left: 0;
    right: 0;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 1px;
  }
  .pg-band {
    position: absolute;
    top: var(--pg-cap);
    bottom: var(--pg-base);
    left: 0;
    right: 0;
    padding: 2px 8px;
  }
  .pg-base {
    position: absolute;
    bottom: 0;
    height: var(--pg-base);
    left: 0;
    right: 0;
    display: grid;
    place-content: center;
    color: var(--hp-outline-variant);
  }

  .pg-t1 {
    display: grid;
    place-items: center;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .pg-t1 .pg-dot {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.45em;
    background: var(--hp-secondary);
    border-radius: 50%;
  }
  .pg-t1 .pg-count {
    display: block;
    text-align: center;
    color: var(--hp-on-surface-variant);
    font-size: 8px;
  }

  .pg-t2 {
    display: grid;
    place-content: center;
    text-align: center;
    gap: 2px;
    font-size: 4.6px;
  }
  .pg-t2 h2 {
    font-size: 7px;
    letter-spacing: 0.08em;
    font-weight: 400;
    margin: 0;
  }
  .pg-t2 .pg-role {
    color: var(--hp-on-surface-variant);
  }
  .pg-t2 .pg-stats {
    color: var(--hp-secondary);
  }
  .pg-t2 .pg-preview {
    color: var(--hp-on-surface-variant);
    text-align: left;
    font-size: 3.4px;
    line-height: 1.5;
  }

  .pg-t3 {
    font-size: 1.9px;
  }
  .pg-t3 h2 {
    font-size: 3.4px;
    letter-spacing: 0.08em;
    font-weight: 400;
    margin: 0;
  }
  .pg-t3 .pg-role {
    color: var(--hp-on-surface-variant);
    font-size: 2.1px;
  }
  .pg-t3 .pg-band {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
