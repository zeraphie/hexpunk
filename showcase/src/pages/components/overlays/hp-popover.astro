---
import Layout from "../../../layouts/Layout.astro";
import ComponentDocs from "../../../components/ComponentDocs.astro";
---

<Layout title="hp-popover">
  <ComponentDocs title="hp-popover">
    <p slot="description">
      Anchored floating panel — click a trigger to open a panel positioned against it. Side
      / align preference with automatic flip on overflow, click-outside and Escape dismiss,
      focus restoration to the trigger on close. Unlike
      <code>&lt;hp-tooltip&gt;</code>, the panel body can contain focusable controls.
    </p>

    <hp-demo caption="Click trigger to open">
      <hp-popover side="bottom" align="start">
        <hp-button>open</hp-button>
        <div slot="content">
          <strong>Quick info</strong>
          <p style="margin: 8px 0 0">Anchored to the trigger; flips if the viewport edge gets in the way.</p>
        </div>
      </hp-popover>

      <hp-code slot="code" language="html">{`<body>
  <hp-popover side="bottom" align="start">
    <hp-button>open</hp-button>

    <div slot="content">
      <strong>Quick info</strong>
      <p>...</p>
    </div>
  </hp-popover>
</body>`}</hp-code>
    </hp-demo>

    <hp-demo caption='trigger="hover" — the hover-card behaviour'>
      <hp-popover trigger="hover" side="bottom" align="start">
        <span class="hover-handle">@hissalia</span>
        <div slot="content" class="hover-body">
          <strong>Hissalia</strong>
          <p>Hexpunk's first inhabitant. The panel is interactive — links and buttons
          inside stay reachable while the pointer travels over.</p>
          <hp-button size="sm">follow</hp-button>
        </div>
      </hp-popover>
      <hp-code slot="code" language="html">{`<body>
  <hp-popover trigger="hover">
    <span>@hissalia</span>
    <div slot="content">
      <strong>Hissalia</strong>
      <p>…</p>
      <hp-button size="sm">follow</hp-button>
    </div>
  </hp-popover>
</body>`}</hp-code>
    </hp-demo>

    <Fragment slot="intent">
      <h2>Accessibility</h2>
      <p>
        Trigger auto-stamps <code>aria-haspopup="dialog"</code> and toggles
        <code>aria-expanded</code>. Panel exposes <code>role="dialog"</code>. Click outside or
        Escape dismisses; focus returns to the trigger on close (when focus was inside the
        panel).
      </p>
    </Fragment>
  </ComponentDocs>

  <style>
    .hover-handle {
      color: var(--hp-primary);
      cursor: default;
      text-decoration: underline;
      text-decoration-style: dotted;
    }

    .hover-body {
      display: grid;
      gap: var(--hp-sm);
      justify-items: start;
      max-width: 26ch;
    }

    .hover-body p {
      margin: 0;
      color: var(--hp-on-surface-variant);
    }
  </style>
</Layout>
