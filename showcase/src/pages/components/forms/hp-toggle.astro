---
import Layout from "../../../layouts/Layout.astro";
import ComponentDocs from "../../../components/ComponentDocs.astro";
---

<Layout title="hp-toggle">
  <ComponentDocs title="hp-toggle">
    <p slot="description">
      Hex switch — a thin light-DOM alias over <code>&lt;input type="checkbox"
      role="switch"&gt;</code>. A stretched-octagon track whose corner cuts match the
      sliding hex thumb's angles, so the thumb sits flush at either end. Discrete on/off;
      use <a href="/components/forms/hp-slider">hp-slider</a> for continuous values.
    </p>

    <hp-demo caption="States">
      <div class="col">
        <hp-toggle>Off at rest</hp-toggle>
        <hp-toggle checked>On</hp-toggle>
        <hp-toggle disabled>Disabled off</hp-toggle>
        <hp-toggle checked disabled>Disabled on</hp-toggle>
      </div>
      <hp-code slot="code" language="html">{`<body>
  <hp-toggle>Off at rest</hp-toggle>
  <hp-toggle checked>On</hp-toggle>
  <hp-toggle disabled>Disabled off</hp-toggle>
  <hp-toggle checked disabled>Disabled on</hp-toggle>
</body>`}</hp-code>
    </hp-demo>

    <hp-demo caption="Form participation">
      <form id="tg-form" onsubmit="event.preventDefault()">
        <div class="col">
          <hp-toggle name="motion" checked>Reduce motion</hp-toggle>
          <hp-toggle name="contrast">High contrast</hp-toggle>
          <hp-button size="sm" id="tg-read">Read FormData</hp-button>
          <pre id="tg-out" class="tg-out">–</pre>
        </div>
      </form>
      <hp-code slot="code" language="html">{`<body>
  <form>
    <hp-toggle name="motion" checked>Reduce motion</hp-toggle>
    <hp-toggle name="contrast">High contrast</hp-toggle>
  </form>
</body>`}</hp-code>
    </hp-demo>

    <Fragment slot="intent">
      <h2>Accessibility</h2>
      <p>
        The native input carries <code>role="switch"</code> semantics, Space toggling,
        label activation, and the focus ring. <code>change</code> bubbles with the input
        as target.
      </p>
      <hp-banner tone="do">
        Use a switch for a setting that takes effect immediately; use hp-checkbox for
        something a form submits later.
      </hp-banner>
    </Fragment>
  </ComponentDocs>

  <style>
    .col {
      display: grid;
      gap: var(--hp-sm);
      justify-items: start;
    }

    .tg-out {
      font-size: var(--hp-typo-body-sm-font-size);
      color: var(--hp-on-surface-variant);
      background: var(--hp-surface-dim);
      border: 1px solid var(--hp-outline-variant);
      padding: var(--hp-sm);
      margin: 0;
    }
  </style>

  <script>
    import { onPageVisit } from "../../../lib/visit.ts";

    onPageVisit((signal) => {
      const form = document.getElementById("tg-form") as HTMLFormElement | null;
      if (!form) {
        return;
      }
      const out = document.getElementById("tg-out")!;
      document.getElementById("tg-read")!.addEventListener(
        "click",
        () => {
          const entries = [...new FormData(form).entries()]
            .map(([k, v]) => `${k}=${String(v)}`)
            .join("  ");
          out.textContent = entries || "(no entries)";
        },
        { signal }
      );
    });
  </script>
</Layout>
