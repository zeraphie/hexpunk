---
import Layout from "../../../layouts/Layout.astro";
import ComponentDocs from "../../../components/ComponentDocs.astro";
---

<Layout title="hp-form">
  <ComponentDocs title="hp-form">
    <p slot="description">
      Form container — thin wrapper around the native <code>&lt;form&gt;</code> with the
      hexpunk spacing defaults applied. Forwards <code>method</code>, <code>action</code>,
      <code>name</code>, <code>novalidate</code>. The hex controls participate natively
      (FormData, validation) with or without it; hp-form's real job — validation modes,
      focus-first-error, error display, schema resolvers — is a dedicated follow-up.
    </p>

    <hp-demo caption="Basic">
      <hp-form>
        <hp-checkbox name="terms" required>Accept terms</hp-checkbox>
        <hp-toggle name="notifications">Enable notifications</hp-toggle>
        <div style="display: flex; gap: 12px;">
          <hp-button type="submit" filled>save</hp-button>
          <hp-button type="reset">reset</hp-button>
        </div>
      </hp-form>

      <hp-code slot="code" language="html">{`<body>
  <hp-form>
    <hp-checkbox name="terms" required>Accept terms</hp-checkbox>
    <hp-toggle name="notifications">Enable notifications</hp-toggle>
    <hp-button type="submit">save</hp-button>
  </hp-form>
</body>`}</hp-code>
    </hp-demo>

    <Fragment slot="intent">
      <h2>Status</h2>
      <p>
        Work in progress — the container ships layout chrome today. The form-interaction
        feature set (validation modes, per-field error display, focus-first-error,
        reset/trigger, schema resolvers, field arrays) lands in its own thread now that
        the controls are native participants.
      </p>
    </Fragment>
  </ComponentDocs>
</Layout>
