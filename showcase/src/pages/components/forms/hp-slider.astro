---
import Layout from "../../../layouts/Layout.astro";
import ComponentDocs from "../../../components/ComponentDocs.astro";
---

<Layout title="hp-slider">
  <ComponentDocs title="hp-slider">
    <p slot="description">
      Hex slider — a thin light-DOM alias over <code>&lt;input type="range"&gt;</code>.
      Dragging, keyboard stepping (arrows, PageUp/PageDown, Home/End), focus, and form
      participation are all the browser's; the element paints the hex thumb and keeps the
      track's fill in sync with the value.
    </p>

    <hp-demo caption="Basic">
      <div class="col">
        <hp-slider value="42">Volume</hp-slider>
        <hp-slider min="0" max="10" step="1" value="7">Zoom (0–10)</hp-slider>
        <hp-slider value="30" disabled>Disabled</hp-slider>
      </div>
      <hp-code slot="code" language="html">{`<body>
  <hp-slider value="42">Volume</hp-slider>
  <hp-slider min="0" max="10" step="1" value="7">Zoom (0–10)</hp-slider>
  <hp-slider value="30" disabled>Disabled</hp-slider>
</body>`}</hp-code>
    </hp-demo>

    <hp-demo caption="Live value">
      <div class="col">
        <hp-slider id="live-slider" name="level" value="50">Level</hp-slider>
        <pre id="slider-out" class="slider-out">level=50</pre>
      </div>
      <hp-code slot="code" language="html">{`<body>
  <hp-slider name="level" value="50">Level</hp-slider>
  <script>
    slider.addEventListener("input", (e) => {
      console.log(e.target.value); // the inner range input
    });
  </script>
</body>`}</hp-code>
    </hp-demo>

    <Fragment slot="intent">
      <h2>Accessibility</h2>
      <p>
        The native range input announces as a slider with min / max / now, steps with the
        keyboard, and activates from its wrapping label. <code>input</code> fires while
        dragging, <code>change</code> on release — both bubble with the input as target.
      </p>
      <hp-banner tone="do">
        Put the label in the default slot — it lands inside the wrapping label, so
        clicking it focuses the slider.
      </hp-banner>
    </Fragment>
  </ComponentDocs>

  <style>
    .col {
      display: grid;
      gap: var(--hp-md);
      justify-items: stretch;
      max-width: 24rem;
    }

    .slider-out {
      font-size: var(--hp-typo-body-sm-font-size);
      color: var(--hp-on-surface-variant);
      background: var(--hp-surface-container-low);
      border: 1px solid var(--hp-outline-variant);
      padding: var(--hp-sm);
      margin: 0;
    }
  </style>

  <script>
    import { onPageVisit } from "../../../lib/visit.ts";

    onPageVisit((signal) => {
      const slider = document.getElementById("live-slider");
      if (!slider) {
        return;
      }
      const out = document.getElementById("slider-out")!;
      slider.addEventListener(
        "input",
        (e) => {
          out.textContent = `level=${(e.target as HTMLInputElement).value}`;
        },
        { signal }
      );
    });
  </script>
</Layout>
