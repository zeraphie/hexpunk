---
import Layout from "../layouts/Layout.astro";
import { getChangelog, renderInline, titleCase } from "../lib/changelog.ts";

// Rendered straight from the repo CHANGELOG.md (Keep a Changelog) so
// this page can never drift from the source of truth. Empty entries
// (an unpopulated [Unreleased]) are skipped.
const entries = getChangelog().filter((entry) => Object.keys(entry.sections).length > 0);
---

<Layout title="Releases" prose>
  <h1>Releases</h1>

  {
    entries.map((entry) => (
      <section>
        <h2>
          v{entry.version}
          {entry.date && ` — ${entry.date}`}
        </h2>
        {Object.entries(entry.sections).map(([name, bullets]) => (
          <>
            <h3>{titleCase(name)}</h3>
            <ul>
              {bullets.map((bullet) => (
                <li set:html={renderInline(bullet)} />
              ))}
            </ul>
          </>
        ))}
      </section>
    ))
  }

  <p>
    This page renders from
    <a href="https://github.com/zeraphie/hexpunk/blob/main/CHANGELOG.md">CHANGELOG.md</a> — the
    canonical release record.
  </p>
</Layout>
